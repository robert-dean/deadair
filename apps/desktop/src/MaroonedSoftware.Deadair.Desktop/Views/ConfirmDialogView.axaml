<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.ConfirmDialogView"
    x:DataType="vm:ConfirmDialogViewModel">

    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Classes="secondary" />

</UserControl>
