<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:conv="using:MaroonedSoftware.Deadair.Desktop.Themes"
    xmlns:views="using:MaroonedSoftware.Deadair.Desktop.Views"
    xmlns:controls="using:MaroonedSoftware.Deadair.Desktop.Controls"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.DeskView"
    x:DataType="vm:ListenerViewModel">

    <UserControl.Resources>
        <conv:ToneBrushConverter x:Key="ToneBrush" />
    </UserControl.Resources>

    <!--
        What is on air, given the room.

        The old desk gave the record a 220px thumbnail beside a 380px column of operator controls,
        with the transport underneath, and spent about half the window on nothing. The record is the
        thing this app is for, so it is the thing the page is: the cover at the size the window can
        spare and the title at display size. What is coming up is in the Now playing panel beside
        every page (`NowPlayingPanel`), where it used to be a card on this one.

        There is no Listen button here. The bar has the only one, on every page.

        Under the record, for an operator, is the station's air (StationAirView). It scrolls with
        the page rather than squeezing the hero: at the window's minimum the two do not both fit.
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{DynamicResource DaPageGutter}" Spacing="24">

        <!-- The area is stretched so its width is the COLUMN's rather than its content's, which is
             what makes it safe to size the cover from. The hero inside is centred, so the record
             sits in the middle of the page rather than hard left. -->
        <Panel x:Name="HeroArea">
        <!-- Stretched, not centred. A Grid does not clip its children, so a centred one keeps its
             DESIRED width and draws over whatever is beside it — which at the window's minimum was
             the cover disappearing behind the operator card. Stretched, the words are given a real
             width and trim into it; `MaxWidth` still centres the group when there is room to spare. -->
        <!-- A page header, as a web player heads an album: the cover and the words top-aligned on the
             cover's wash (CoverWash, under the page), the words sitting on the cover's bottom edge. -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24"
              HorizontalAlignment="Stretch" VerticalAlignment="Top">

            <!-- Square, and never rounded: a rounded cover is this app's frame around somebody
                 else's picture. The initial shows through until the art arrives, and stays when
                 there is none — art is hotlinked until the station caches it, so a dead upstream is
                 ordinary rather than a fault. -->
            <Border x:Name="Cover" Classes="art" Width="232" Height="232" VerticalAlignment="Bottom"
                    BorderBrush="{DynamicResource DaBorderBrush}" BorderThickness="1"
                    BoxShadow="{DynamicResource DaHeroShadow}">
                <Panel>
                    <TextBlock Text="{Binding Initial}" FontSize="96" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource DaTextDimmedBrush}" />
                    <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                </Panel>
            </Border>

            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Bottom">
                <!-- Wraps rather than clips: beside the operator card this row has about half the
                     width, and three eyebrows and a lamp do not fit on one line there. -->
                <WrapPanel ItemSpacing="10" LineSpacing="4">
                    <Ellipse Classes="lamp" Classes.live="{Binding OnAir}" Width="8" Height="8"
                             VerticalAlignment="Center"
                             Fill="{Binding AirTone, Converter={StaticResource ToneBrush}}" />
                    <TextBlock Classes="eyebrow" Text="ON AIR NOW" IsVisible="{Binding OnAir}"
                               Foreground="{DynamicResource DaToneLiveBrush}" />
                    <TextBlock Classes="eyebrow" Text="OFF AIR" IsVisible="{Binding !OnAir}" />
                    <TextBlock Classes="eyebrow" Text="{Binding StationName}" />
                    <TextBlock Classes="eyebrow" Text="{Binding ListenersLabel}" />
                </WrapPanel>

                <!-- Its own line height: `display`'s 40 is for 34pt type and cut the top off 48. -->
                <TextBlock Classes="display" FontSize="{DynamicResource DaFontSizeHero}" LineHeight="56"
                           LetterSpacing="-1"
                           Text="{Binding Title, FallbackValue='Nothing on air'}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Artist}" Classes="secondary" FontSize="17"
                           IsVisible="{Binding HasArtist}"
                           TextWrapping="Wrap" MaxLines="2" />
                <!-- The presenter's picture beside their name when the station has one, square like
                     every picture here. Absent during a break that has taken it as the cover. The gap
                     is the picture's margin rather than the grid's spacing, which a hidden column
                     still pays, so a line with no picture sits exactly where it always did. -->
                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasHostLine}">
                    <controls:Artwork Size="24" Source="{Binding HostPortrait}" Initial="{Binding HostInitial}"
                                      IsVisible="{Binding HasHostPortrait}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding HostLine}" Classes="secondary"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock Text="{Binding Album}" Classes="dimmed" TextTrimming="CharacterEllipsis" />

                <!-- Off air is the ordinary resting state of an audience-gated station, so it gets a
                     sentence saying what to do about it rather than a warning colour. -->
                <TextBlock Classes="dimmed" TextWrapping="Wrap" IsVisible="{Binding !OnAir}"
                           Text="The station is quiet. Press Listen and it wakes up." />

                <!-- A failed poll keeps the last good answer and says it is old, rather than
                     blanking a screen that still holds something true. -->
                <TextBlock Text="Not answering. Showing the last reading." IsVisible="{Binding Stale}"
                           Foreground="{DynamicResource DaToneFaultBrush}" />
            </StackPanel>
        </Grid>
        </Panel>

        <!-- The operator's half of the desk. Its view models are the running order's, which this
             page (whose own context is the listener) reaches through the window, as the bar does. -->
        <views:StationAirView
            DataContext="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Order.Air}"
            IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Order.IsOperator}" />

        <!-- What needs a person, worst first. Under the air rather than above it: the air is the
             question every visit starts with, and this is the reason to have opened the desk. -->
        <views:NeedsYouView
            DataContext="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Order.NeedsYou}"
            IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Order.IsOperator}" />

    </StackPanel>
    </ScrollViewer>

</UserControl>
