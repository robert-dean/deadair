{
    "name": "@deadair/api",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "main": "index.ts",
    "imports": {
        "#src/*": {
            "development": "./src/*",
            "default": "./dist/*"
        },
        "#routes/*": {
            "development": "./src/routes/*",
            "default": "./dist/routes/*"
        },
        "#modules/*": {
            "development": "./src/modules/*",
            "default": "./dist/modules/*"
        }
    },
    "scripts": {
        "dev": "NODE_ENV=development node scripts/dev.watch.mjs",
        "start": "node dist/index.js",
        "build": "NODE_OPTIONS=--max_old_space_size=8192 tsc",
        "build:data": "echo 'build:data orchestrated by turbo (migrate:up -> build:datatypes)'",
        "codegen": "echo 'codegen orchestrated by turbo (build:data + build:contracts + build:permissions)'",
        "rebuild:data": "pnpm migrate:down:all && pnpm migrate:up && pnpm build:datatypes",
        "build:contracts": "contractkit && prettier --write --log-level warn --ignore-path ../../.prettierignore 'src/routes/*.router.ts' 'src/modules/*/types/*.ts' '../../packages/sdk/src/**/*.ts'",
        "build:permissions": "pdsl",
        "build:datatypes": "pnpm sync:enum-overrides && kysely-codegen",
        "sync:enum-overrides": "node --no-warnings --import @swc-node/register/esm-register scripts/sync.enum.overrides.ts",
        "plugin:prove": "node --no-warnings --import @swc-node/register/esm-register scripts/plugin.prove.ts",
        "migrate:up": "dbmate -d ./data/migrations --no-dump-schema up",
        "migrate:down": "dbmate -d ./data/migrations --no-dump-schema down",
        "migrate:down:all": "./scripts/rollbackall.sh",
        "migrate:create": "dbmate -d ./data/migrations new",
        "lint": "eslint --fix",
        "typecheck": "pnpm typecheck:tests && pnpm typecheck:scripts",
        "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
        "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
        "format": "prettier --write . --ignore-path ../../.prettierignore",
        "test": "vitest run"
    },
    "dependencies": {
        "@deadair/error-codes": "workspace:*",
        "@deadair/plugin-sdk": "workspace:*",
        "@maroonedsoftware/appconfig": "^2.6.1",
        "@maroonedsoftware/authentication": "^5.1.0",
        "@maroonedsoftware/cache": "^0.5.0",
        "@maroonedsoftware/encryption": "^0.5.13",
        "@maroonedsoftware/errors": "^1.9.1",
        "@maroonedsoftware/eventbus": "^0.1.8",
        "@maroonedsoftware/jobbroker": "^1.12.2",
        "@maroonedsoftware/koa": "^4.0.0",
        "@maroonedsoftware/kysely": "^0.7.11",
        "@maroonedsoftware/logger": "^1.1.9",
        "@maroonedsoftware/multipart": "^1.3.8",
        "@maroonedsoftware/permissions": "^0.2.9",
        "@maroonedsoftware/policies": "^0.6.9",
        "@maroonedsoftware/serverfeed": "^0.1.6",
        "@maroonedsoftware/utilities": "^1.11.5",
        "@maroonedsoftware/zod": "^0.8.0",
        "injectkit": "^1.7.1",
        "ioredis": "^6.0.0",
        "koa": "^3.2.1",
        "kysely": "^0.29.5",
        "luxon": "^3.7.2",
        "nodemailer": "^10.0.1",
        "pg": "^8.22.0",
        "pg-boss": "^12.27.0",
        "rate-limiter-flexible": "^11.2.0",
        "reflect-metadata": "^0.2.2",
        "rotating-file-stream": "^3.2.9",
        "semver": "^7.8.5",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@contractkit/cli": "^0.11.3",
        "@contractkit/plugin-csharp": "^0.1.2",
        "@contractkit/plugin-docs": "^0.3.2",
        "@contractkit/plugin-kotlin": "^0.1.4",
        "@contractkit/plugin-typescript": "^0.38.3",
        "@deadair/plugin-musicbrainz": "workspace:*",
        "@deadair/plugin-spotify": "workspace:*",
        "@maroonedsoftware/permissions-dsl": "^0.5.6",
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.15.47",
        "@types/koa": "^3.0.3",
        "@types/koa__router": "^12.0.5",
        "@types/luxon": "^3.7.3",
        "@types/node": "^26.1.2",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.20.3",
        "@types/semver": "^7.8.0",
        "dbmate": "^2.34.1",
        "kysely-codegen": "^0.20.0",
        "prettier": "^3.9.6",
        "typescript": "6.0.3"
    }
}
