#!/bin/sh
# The measurement sidecar: cue points and loudness, decoded outside Node on purpose.
exec 2>&1
cd /opt/analysis || exit 1

# Capped the same way the standalone image caps it: glibc keeps a per-thread
# arena and never returns the decode's pages on its own. See analysis/app.py's
# `_trim`, which handles the other half.
export MALLOC_ARENA_MAX=2

# One worker, always. The decode ceiling is a semaphore INSIDE this process, so a second worker
# would quietly double the number of decodes the machine is asked to do at once. How many actually
# run is the station's own `analysis.concurrency`, under that ceiling.
# Loopback only: nothing outside this container has any business measuring records.
#
# Below Liquidsoap, and every ffmpeg the sidecar spawns inherits it. Measuring a record is work that
# can wait a second; the audio chain is work that cannot, and the two share this machine's cores.
# Measured on the live station, 2026-09-08 to 2026-09-21: every hour Liquidsoap fell behind real
# time (36 of 36, by as much as 26 seconds) was an hour the analyzer was decoding, and the worst of
# them began while the stream sat on silence, so it was not the audio chain's own work that starved
# it. The user the line drops to inherits the value, and without root it cannot raise it back.
exec nice -n 10 s6-setuidgid deadair /opt/analysis/venv/bin/uvicorn app:app \
    --host 127.0.0.1 --port "${ANALYSIS_PORT:-9321}" --workers 1
