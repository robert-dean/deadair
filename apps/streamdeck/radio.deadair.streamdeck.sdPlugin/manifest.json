{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "UUID": "radio.deadair.streamdeck",
    "Name": "deadair",
    "Version": "0.2.1.0",
    "Author": "Marooned Software",
    "Description": "Your deadair station on a Stream Deck: what is on air with its cover and a moving playhead, Skip, a Stop that asks twice, and a heart on the record playing.",
    "URL": "https://deadair.radio",
    "SupportURL": "https://github.com/robert-dean/deadair/issues",
    "Icon": "imgs/plugin/icon",
    "Category": "deadair",
    "CategoryIcon": "imgs/plugin/category-icon",
    "CodePath": "bin/plugin.js",
    "PropertyInspectorPath": "ui/station.html",
    "SDKVersion": 3,
    "Software": {
        "MinimumVersion": "7.1"
    },
    "OS": [
        {
            "Platform": "mac",
            "MinimumVersion": "12"
        },
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Nodejs": {
        "Version": "24"
    },
    "Actions": [
        {
            "UUID": "radio.deadair.streamdeck.now-playing",
            "Name": "Now playing",
            "Tooltip": "What the station is playing, with its cover and how long is left.",
            "Icon": "imgs/actions/now-playing/icon",
            "Controllers": ["Keypad"],
            "SupportedInMultiActions": false,
            "UserTitleEnabled": false,
            "States": [
                {
                    "Image": "imgs/actions/now-playing/key",
                    "TitleAlignment": "bottom",
                    "FontSize": 9
                }
            ]
        },
        {
            "UUID": "radio.deadair.streamdeck.skip",
            "Name": "Skip",
            "Tooltip": "Ends the record or break on air and plays the next one.",
            "Icon": "imgs/actions/skip/icon",
            "Controllers": ["Keypad"],
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/skip/key",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "radio.deadair.streamdeck.like",
            "Name": "Like",
            "Tooltip": "Tells the station to play the record on air more often. Press it again to take it back.",
            "Icon": "imgs/actions/like/icon",
            "Controllers": ["Keypad"],
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/like/key",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "radio.deadair.streamdeck.dislike",
            "Name": "Dislike",
            "Tooltip": "Tells the station never to play the record on air again. Press it again to take it back.",
            "Icon": "imgs/actions/dislike/icon",
            "Controllers": ["Keypad"],
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/dislike/key",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "radio.deadair.streamdeck.transport",
            "Name": "Stop or start",
            "Tooltip": "Stops the station after a second press, or starts it again when it is stopped.",
            "Icon": "imgs/actions/transport/icon",
            "Controllers": ["Keypad"],
            "SupportedInMultiActions": false,
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Name": "Stop",
                    "Image": "imgs/actions/transport/stop",
                    "TitleAlignment": "bottom"
                },
                {
                    "Name": "Start",
                    "Image": "imgs/actions/transport/start",
                    "TitleAlignment": "bottom"
                }
            ]
        }
    ]
}
