<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="using:MaroonedSoftware.Deadair.Desktop.Themes"
    x:Class="MaroonedSoftware.Deadair.Desktop.App"
    RequestedThemeVariant="{x:Static themes:ConsoleThemes.Carbon}">

    <Application.Styles>
        <!-- Compact, because a desk is dense: the console's density argument lives in spacing and
             row height rather than in a smaller type scale. -->
        <FluentTheme DensityStyle="Compact" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://deadair/Themes/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
