{
    "name": "@deadair/api",
    "version": "0.106.1",
    "private": true,
    "license": "MIT",
    "type": "module",
    "main": "index.ts",
    "imports": {
        "#src/*": {
            "development": "./src/*",
            "default": "./dist/*"
        },
        "#routes/*": {
            "development": "./src/routes/*",
            "default": "./dist/routes/*"
        },
        "#modules/*": {
            "development": "./src/modules/*",
            "default": "./dist/modules/*"
        }
    },
    "scripts": {
        "dev": "NODE_ENV=development node scripts/dev.watch.mjs",
        "start": "node dist/index.js",
        "build": "NODE_OPTIONS=--max_old_space_size=8192 tsc",
        "build:data": "echo 'build:data orchestrated by turbo (migrate:up -> build:datatypes)'",
        "codegen": "echo 'codegen orchestrated by turbo (build:data + build:contracts + build:permissions)'",
        "rebuild:data": "pnpm migrate:down:all && pnpm migrate:up && pnpm build:datatypes",
        "build:contracts": "contractkit && prettier --write --log-level warn --ignore-path ../../.prettierignore 'src/routes/*.router.ts' 'src/mcp/*.mcp.ts' 'src/mcp/mcp.tools.ts' 'src/modules/*/types/*.ts' '../../packages/sdk/src/**/*.ts'",
        "build:permissions": "pdsl",
        "build:datatypes": "pnpm sync:enum-overrides && kysely-codegen",
        "sync:enum-overrides": "node --no-warnings --import @swc-node/register/esm-register scripts/sync.enum.overrides.ts",
        "plugin:prove": "node --no-warnings --import @swc-node/register/esm-register scripts/plugin.prove.ts",
        "migrate:up": "dbmate -d ./data/migrations --no-dump-schema up",
        "migrate:down": "dbmate -d ./data/migrations --no-dump-schema down",
        "migrate:down:all": "./scripts/rollbackall.sh",
        "migrate:create": "dbmate -d ./data/migrations new",
        "lint": "eslint --fix",
        "typecheck": "pnpm typecheck:tests && pnpm typecheck:scripts",
        "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
        "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
        "format": "prettier --write . --ignore-path ../../.prettierignore",
        "test": "vitest run"
    },
    "dependencies": {
        "@deadair/error-codes": "workspace:*",
        "@deadair/plugin-sdk": "workspace:*",
        "@maroonedsoftware/appconfig": "^2.7.1",
        "@maroonedsoftware/authentication": "^6.8.1",
        "@maroonedsoftware/cache": "^0.6.1",
        "@maroonedsoftware/comms": "^0.3.1",
        "@maroonedsoftware/encryption": "^0.5.14",
        "@maroonedsoftware/errors": "^1.9.2",
        "@maroonedsoftware/eventbus": "^0.1.8",
        "@maroonedsoftware/jobbroker": "^1.15.1",
        "@maroonedsoftware/koa": "^4.1.5",
        "@maroonedsoftware/kysely": "^0.10.1",
        "@maroonedsoftware/logger": "^1.1.10",
        "@maroonedsoftware/mcp": "^0.9.0",
        "@maroonedsoftware/multipart": "^1.3.9",
        "@maroonedsoftware/permissions": "^0.4.1",
        "@maroonedsoftware/policies": "^0.6.10",
        "@maroonedsoftware/servercore": "^0.5.1",
        "@maroonedsoftware/serverfeed": "^0.1.7",
        "@maroonedsoftware/telemetry": "^0.3.0",
        "@maroonedsoftware/utilities": "^1.11.6",
        "@maroonedsoftware/zod": "^0.8.1",
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/core": "^2.12.1",
        "@opentelemetry/exporter-metrics-otlp-http": "^0.223.2",
        "@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
        "@opentelemetry/resources": "^2.12.1",
        "@opentelemetry/sdk-metrics": "^2.12.1",
        "@opentelemetry/sdk-trace": "^2.12.1",
        "injectkit": "^1.7.1",
        "ioredis": "^6.0.0",
        "koa": "^3.3.0",
        "kysely": "^0.29.9",
        "luxon": "^3.7.2",
        "markdown-it": "^15.0.3",
        "multicast-dns": "^7.2.5",
        "nodemailer": "^10.6.1",
        "pg": "^8.23.1",
        "pg-boss": "^12.39.0",
        "rate-limiter-flexible": "^11.5.0",
        "reflect-metadata": "^0.2.2",
        "rotating-file-stream": "^3.2.10",
        "semver": "^7.8.6",
        "tar": "^7.5.23",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@contractkit/cli": "^0.12.1",
        "@contractkit/plugin-csharp": "^0.4.2",
        "@contractkit/plugin-docs": "^0.10.0",
        "@contractkit/plugin-kotlin": "^0.3.2",
        "@contractkit/plugin-swift": "^0.3.2",
        "@contractkit/plugin-typescript": "^0.44.0",
        "@deadair/plugin-musicbrainz": "workspace:*",
        "@deadair/plugin-spotify": "workspace:*",
        "@maroonedsoftware/permissions-dsl": "^0.6.1",
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.16.22",
        "@types/koa": "^3.0.3",
        "@types/luxon": "^3.7.6",
        "@types/multicast-dns": "^7.2.4",
        "@types/node": "^26.6.6",
        "@types/nodemailer": "^8.0.2",
        "@types/pg": "^8.23.1",
        "@types/semver": "^7.8.0",
        "dbmate": "^2.38.2",
        "kysely-codegen": "^0.20.0",
        "prettier": "^3.10.1",
        "typescript": "6.0.3"
    }
}
