{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // Type-check only: this config exists to cover tests/ as well as src/, which the build
        // tsconfig deliberately leaves out, so rootDir is widened to the package root.
        "noEmit": true,
        "rootDir": "."
    },
    "include": ["./src/**/*", "./tests/**/*", "./tsup.config.ts", "./vitest.config.ts"],
    "exclude": ["node_modules", "radio.deadair.streamdeck.sdPlugin"]
}
