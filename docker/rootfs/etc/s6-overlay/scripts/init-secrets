#!/bin/sh -e
# The two keys the station cannot start without, made on the first boot when the operator gave
# neither.
#
# KMS_LOCAL_ROOT_KEY encrypts every credential the station stores, and
# AUTHENTICATION_SESSION_JWT_PRIVATE_KEY signs every sign-in. Both used to be the operator's job:
# two `openssl` commands, one of which takes different flags on macOS, pasted into a form. Nothing
# about either value is a choice, so the station makes them itself, keeps them on the volume beside
# everything else that is the station, and reads them back on every boot after.
#
# The environment always wins. An operator who wants the root key somewhere other than the volume
# it protects sets the variable, as before, and nothing is written here for that key.

DATA="${DATA_DIR:-/data}"
SECRETS="$DATA/secrets"

mkdir -p "$SECRETS"
chown 99:100 "$SECRETS" 2>/dev/null || true
chmod 700 "$SECRETS"

# Written to a temporary name and moved into place, so a boot interrupted halfway leaves no key
# file at all rather than a truncated one the next boot would believe.
make_secret() {
    name="$1"
    script="$2"
    file="$SECRETS/$name"
    [ -s "$file" ] && return 0
    (
        umask 077
        node -e "$script" > "$file.tmp"
    )
    chown 99:100 "$file.tmp" 2>/dev/null || true
    mv "$file.tmp" "$file"
    echo "init-secrets: no $name was set, so one was made in $file. Back it up with the rest of $DATA."
}

if [ -z "${KMS_LOCAL_ROOT_KEY:-}" ]; then
    make_secret KMS_LOCAL_ROOT_KEY "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
elif [ -s "$SECRETS/KMS_LOCAL_ROOT_KEY" ] \
    && [ "$(tr -d '[:space:]' < "$SECRETS/KMS_LOCAL_ROOT_KEY" | tr 'A-F' 'a-f')" != "$(printf '%s' "$KMS_LOCAL_ROOT_KEY" | tr -d '[:space:]' | tr 'A-F' 'a-f')" ]; then
    # Only the root key is compared. A different one means every credential stored under the one
    # in the file can no longer be read, which is worth shouting about on every boot. A different
    # session key only signs everybody out once, and its three accepted spellings make a fair
    # comparison more trouble than that is worth.
    echo "init-secrets: KMS_LOCAL_ROOT_KEY is set and differs from the one in $SECRETS/KMS_LOCAL_ROOT_KEY. The variable wins, so credentials the station stored under the key in that file cannot be read. If that is not what you meant, unset the variable." >&2
fi

if [ -z "${AUTHENTICATION_SESSION_JWT_PRIVATE_KEY:-}" ]; then
    make_secret AUTHENTICATION_SESSION_JWT_PRIVATE_KEY "process.stdout.write(require('node:crypto').generateKeyPairSync('rsa', { modulusLength: 2048 }).privateKey.export({ type: 'pkcs8', format: 'pem' }))"
fi
