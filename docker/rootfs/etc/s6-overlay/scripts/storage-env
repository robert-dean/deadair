# Sourced, not run.
#
# Where the record cache goes, which is the one thing the station keeps that is both large and
# worth nothing.
#
# Everything else under the volume is small and was authored: the settings, the presenters, the
# schedule, the operator's own recordings, and on one variant the database. The cached audio is
# neither — it is a copy of records a provider will hand over again, it grows to the size of the
# library, and losing it costs a download. Those two want different disks and usually different
# backup policies, so a server with fast storage for one and bulk storage for the other should be
# able to say so.
#
# It is decided by whether `/tracks` was actually mounted rather than by a second setting, because
# a path and a variable that have to agree are a pair that can disagree — and the way they
# disagree here is the worst one available: the station writes its whole library into the
# container's own filesystem, which on a home server means quietly filling the disk image every
# container on the machine shares. Unmounted, the cache stays on the volume where it has always
# been.
if [ -z "${TRACKS_DIR:-}" ]; then
    if awk '$2 == "/tracks" { found = 1 } END { exit !found }' /proc/mounts 2>/dev/null; then
        TRACKS_DIR=/tracks
    else
        TRACKS_DIR="${DATA_DIR:-/data}/media/tracks"
    fi
    export TRACKS_DIR
fi
