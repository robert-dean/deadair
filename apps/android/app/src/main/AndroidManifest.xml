<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Offered where the phone has a wallpaper picker, and simply absent where it has not. -->
    <!--
      Package visibility: from API 30 an app cannot see which activity handles an intent unless it
      says which intents it cares about, and the wallpaper picker is another app. Without this the
      picker resolves to nothing and the Set as wallpaper button hides itself on a phone that has one.
    -->
    <queries>
        <intent>
            <action android:name="android.service.wallpaper.CHANGE_LIVE_WALLPAPER" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Held by the player while it is playing, so a dozing phone does not tear the stream down. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
        Mandatory from API 34: a foreground service must declare its type as a permission as well as
        an attribute, and `startForeground` throws without it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
        A notification tied to a MediaSession is exempt from the runtime permission on 33+, so the
        player's notification appears without this being granted. The app still asks, at the first
        press of play rather than at launch, because the exemption is easy to lose to a platform
        release or a manufacturer's build and one dialog at the moment it makes sense is cheap.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DeadairApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Deadair">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Deadair">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                "Play deadair" to the car's assistant. Android Auto asks for this to offer voice at
                all; what it plays is decided by the session, which has only the station to give.
            -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!--
                deadair://connect?station=<origin>, which the console writes, and deadair://<host>.
                A link only proposes a station: the setup screen opens with it filled in.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="deadair" />
            </intent-filter>
        </activity>

        <!--
            What a media button reaches when the service is not running: a Bluetooth play button
            pressed on getting into a car, or the play button Android keeps in its media carousel
            after a reboot. It starts the service, which then answers with the mount to resume on.
            Without it both of those press nothing at all.
        -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
            Exported, and it has to be: the session is how the lock screen, a Bluetooth head unit,
            Android Auto and Android's own media controls reach this app, and none of them are this
            app. The library action is what a Media3 browser looks for, the legacy browser action is
            what Android Auto looks for, and the session action stays for this app's own controller.
        -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
            The station as a Quick Settings tile. Bound only by System UI, which is what the
            permission guarantees; toggleable, so accessibility services read it as on or off.
        -->
        <activity
            android:name=".wallpaper.WallpaperSettingsActivity"
            android:exported="true"
            android:label="@string/wallpaper_label" />

        <service
            android:name=".wallpaper.StationWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/station_wallpaper" />
        </service>

        <!--
            The station on the home screen. Not exported: the only thing that talks to a widget
            provider is the system, which reaches it whether or not anybody else could.
        -->
        <receiver
            android:name=".widget.StationWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/station_widget" />
        </receiver>

        <service
            android:name=".playback.StationTileService"
            android:exported="true"
            android:icon="@drawable/ic_radio"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- What tells Android Auto this is a media app, and so lists it in the car. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>
</manifest>
