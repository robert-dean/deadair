{
    "name": "@deadair/plugin-llm",
    "version": "0.51.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "license": "MIT",
    "files": [
        "dist/**"
    ],
    "deadair": {
        "plugin": "./dist/index.js"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm --sourcemap && tsc --emitDeclarationOnly --declaration",
        "build:ci": "eslint --max-warnings=0 && pnpm run build",
        "lint": "eslint --fix",
        "format": "prettier --write . --ignore-path ../../.prettierignore",
        "test": "vitest run"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.78",
        "@ai-sdk/google": "^4.0.93",
        "@ai-sdk/openai-compatible": "^3.0.67",
        "ai": "^7.0.136"
    },
    "peerDependencies": {
        "@deadair/plugin-sdk": "workspace:*",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@deadair/plugin-sdk": "workspace:*",
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "vitest": "^5.0.3",
        "zod": "^4.6.5"
    }
}
