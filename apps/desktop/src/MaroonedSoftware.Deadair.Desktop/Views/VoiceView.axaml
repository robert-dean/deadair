<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:conv="using:MaroonedSoftware.Deadair.Desktop.Themes"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.VoiceView"
    x:DataType="vm:VoiceViewModel">

    <UserControl.Resources>
        <conv:ToneBrushConverter x:Key="ToneBrush" />
    </UserControl.Resources>

    <DockPanel Margin="{DynamicResource DaPageGutter}" LastChildFill="True" MaxWidth="980"
               HorizontalAlignment="Left">

        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,14">
            <TextBlock Classes="h1" Text="Voice" />

            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="tab" Classes.active="{Binding IsCharacters}" Content="Characters"
                        Command="{Binding ShowTabCommand}" CommandParameter="Characters" />
                <Button Classes="tab" Classes.active="{Binding IsSaid}" Content="What it said"
                        Command="{Binding ShowTabCommand}" CommandParameter="Said" />
                <Button Classes="tab" Classes.active="{Binding IsSegments}" Content="Segments"
                        Command="{Binding ShowTabCommand}" CommandParameter="Segments" />
                <Button Classes="tab" Classes.active="{Binding IsProductions}" Content="Productions"
                        Command="{Binding ShowTabCommand}" CommandParameter="Productions" />
            </StackPanel>

            <TextBlock Classes="dimmed" Text="{Binding Notice}" TextWrapping="Wrap"
                       IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <Panel>

            <ListBox Classes="rows" ItemsSource="{Binding Personas}" IsVisible="{Binding IsCharacters}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PersonaRowViewModel">
                        <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="10" Margin="0,7">
                            <!-- The tally: one persona presents at a time. The column keeps its width
                                 whether the lamp is drawn or not, or the names do not line up. -->
                            <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,6,0,0"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource DaToneLiveBrush}" IsVisible="{Binding Active}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource DaTextBrush}" />
                                <TextBlock Text="{Binding Style}" FontSize="12" TextWrapping="Wrap"
                                           MaxWidth="620" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource DaTextDimmedBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="reveal ghost" Content="Put on air"
                                    FontSize="11" Padding="8,3"
                                    VerticalAlignment="Top" IsVisible="{Binding !Active}"
                                    Command="{Binding $parent[ListBox].((vm:VoiceViewModel)DataContext).PutOnAirCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- One row per ATTEMPT rather than per segment: a model that declined and the floor that
                 covered for it are two facts, not one misleading one. -->
            <ListBox Classes="rows" ItemsSource="{Binding Scripts}" IsVisible="{Binding IsSaid}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScriptRowViewModel">
                        <Grid ColumnDefinitions="Auto,54,90,*" ColumnSpacing="10" Margin="0,4">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Top" Margin="0,6,0,0"
                                     Fill="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                            <TextBlock Classes="mono" Grid.Column="1" Text="{Binding When}" FontSize="11"
                                       Foreground="{DynamicResource DaTextDimmedBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DaTextDimmedBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource DaTextSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox Classes="rows" ItemsSource="{Binding Segments}" IsVisible="{Binding IsSegments}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SegmentRowViewModel">
                        <Grid ColumnDefinitions="Auto,*,110,90" ColumnSpacing="10" Margin="0,4">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DaTextBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="11"
                                       Foreground="{DynamicResource DaTextDimmedBrush}" />
                            <!-- `ready` alone can air; everything before it is a stage of being made. -->
                            <TextBlock Grid.Column="3" Text="{Binding State}" FontSize="11"
                                       Foreground="{DynamicResource DaTextDimmedBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox Classes="rows" ItemsSource="{Binding Productions}" IsVisible="{Binding IsProductions}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProductionRowViewModel">
                        <!-- Fixed widths, not `Auto`. Every row is its own Grid, so an `Auto` column
                             sizes to that row alone and the columns do not line up down the list —
                             which is exactly how this looked before. -->
                        <Grid ColumnDefinitions="380,90,110,96" ColumnSpacing="14">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DaTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Kind}" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource DaTextDimmedBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource DaTextSecondaryBrush}" />
                            <Button Grid.Column="3" Classes="reveal ghost" Content="Cancel"
                                    FontSize="11" Padding="8,3"
                                    HorizontalAlignment="Left" IsVisible="{Binding CanCancel}"
                                    Command="{Binding $parent[ListBox].((vm:VoiceViewModel)DataContext).CancelProductionCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Panel>

    </DockPanel>

</UserControl>
