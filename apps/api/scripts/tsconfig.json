{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "rootDir": "..",
        "noEmit": true,
        "paths": {
            "#src/*": ["../src/*"],
            "#routes/*": ["../src/routes/*"],
            "#modules/*": ["../src/modules/*"],
            "#shared/*": ["../src/shared/*"],
            "#vendors/*": ["../src/modules/vendors/*"]
        }
    },
    "include": ["../scripts/**/*", "../src/**/*"]
}
