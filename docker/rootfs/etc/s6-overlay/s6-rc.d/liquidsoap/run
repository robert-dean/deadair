#!/bin/sh
# The audio chain: what plays, what ducks under what, and what is handed to the stream.
#
# `timeout-kill` beside this file is what makes a restart finish. Measured on 2026-09-13: a
# Liquidsoap that had stopped playing what it was handed also stopped at "Waiting for main threads
# to terminate" when it was told to stop, and never got further. Without the timeout the supervisor
# sends the stop signal and waits for ever, and so does anything that asked for the restart. The
# timeout applies only to a service taken DOWN, never to `s6-svc -r`, which is why the config watch
# restarts this one down-then-up. Ten seconds is generous against an ordinary shutdown, which the
# log shows taking under one.
exec 2>&1

# Every setting reaches Liquidsoap through this file and no other way — there is no command line
# and no second source. The app writes it; until the app has, the committed defaults stand.
config=/data/streamconfig/radio.env
[ -f "$config" ] || config=/defaults/radio.env

# Somewhere to keep the compiled script. The default is the HOME of whoever is running, which in
# the image this base ships is root — and here this runs as the station's user, so every start
# said it could not read root's cache and then compiled the whole script again. It goes on the
# volume rather than in the image because the point of it is to survive a restart.
#
# Made here rather than left to Liquidsoap: this part runs as root, so the directory has to be
# handed to the user the line below drops to. It reads nothing from the config, which is what lets
# it stay above the drop.
mkdir -p /data/streamstate/.cache
chown 99:100 /data/streamstate /data/streamstate/.cache 2>/dev/null || true

# Everything from here runs as the station's user, and that INCLUDES reading the config. The file
# is written by the app, which runs as that same user, so sourcing it as root would let anything
# able to write a setting run a command as root: a value is shell, and `$(…)` in one is executed
# by `.` before Liquidsoap ever sees it. Dropping first means the worst a hostile line can do is
# what the app could already do. The file is handed over as `$1` rather than spliced into the
# script, so no path is ever parsed as shell either.
#
# HOME is set after the file is read, as it always was, so a stray HOME in it changes nothing.
# LOG_FILE is not in the rendered file, because it is a property of this image's layout rather than
# of the station's settings.
# shellcheck disable=SC2016
exec s6-setuidgid deadair sh -c '
set -a
# shellcheck disable=SC1090
. "$1"
set +a
HOME=/data/streamstate
LOG_FILE="${LOG_FILE:-/data/streamlogs/liquidsoap.log}"
export HOME LOG_FILE
exec liquidsoap /radio/radio.liq
' sh "$config"
