<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.SetupView"
    x:DataType="vm:SetupViewModel">

    <Border Padding="48">
        <StackPanel MaxWidth="420" Spacing="18" VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- The mark, at half its pixel size so it is crisp on a Retina display. This is the one
                 screen with room for it: the sidebar's strip tried it and took it out (see
                 apps/desktop/CLAUDE.md), and here it is the only thing above the fold on a first run. -->
            <Image
                Source="avares://deadair/Assets/logo-mark.png"
                Width="96"
                Height="96"
                Margin="0,0,0,6"
                HorizontalAlignment="Center" />

            <TextBlock
                Text="deadair"
                FontSize="{DynamicResource DaFontSizeH1}"
                FontWeight="Bold"
                LetterSpacing="1.4"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource DaAccentBrush}" />

            <TextBlock
                Text="The address of your station. Something like radio.example.com."
                TextWrapping="Wrap"
                Foreground="{DynamicResource DaTextSecondaryBrush}" />

            <!-- Which station this would replace, when there is one. Not a problem, so not in the
                 fault colour: somebody followed a link or pressed Change station, and this says
                 what connecting will leave. -->
            <TextBlock
                Text="{Binding Note}"
                IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}"
                TextWrapping="Wrap"
                Foreground="{DynamicResource DaTextBrush}" />

            <TextBox
                x:Name="AddressBox"
                Text="{Binding Address}"
                PlaceholderText="radio.example.com"
                FontFamily="{DynamicResource DaFontMono}"
                IsEnabled="{Binding !Busy}" />

            <!-- The default button, so Enter in the address box connects, as it does in any Mac dialog.
                 Safe on a screen that is hidden most of the time: Avalonia 12 answers Enter only for a
                 default button that is EFFECTIVELY visible and enabled, and this one is neither once a
                 station is attached, nor while the box is empty or a probe is running. The box leaves
                 Enter unhandled because it does not accept returns, so it reaches the window. -->
            <Button
                Content="Connect"
                IsDefault="True"
                Command="{Binding ConnectCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="0,10" />

            <!-- Only when there is a station to go back to; a first run has nowhere else to be. -->
            <Button
                Classes="ghost"
                Content="Keep the station I have"
                Command="{Binding CancelCommand}"
                IsVisible="{Binding CanCancel}"
                HorizontalAlignment="Center" />

            <!-- The station's four answers get four sentences: what to do about "not a station" and
                 about "nothing answered" are different things. -->
            <TextBlock
                Text="{Binding Problem}"
                IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}"
                TextWrapping="Wrap"
                Foreground="{DynamicResource DaToneFaultBrush}" />

            <TextBlock
                Text="Asking the station…"
                IsVisible="{Binding Busy}"
                Foreground="{DynamicResource DaTextDimmedBrush}" />

            <!-- Often the reason this screen is showing at all: an unreadable settings file takes the
                 address with it, and an address typed here now will not be kept either. -->
            <TextBlock
                Text="{Binding SettingsProblem}"
                IsVisible="{Binding SettingsProblem, Converter={x:Static ObjectConverters.IsNotNull}}"
                TextWrapping="Wrap"
                Foreground="{DynamicResource DaToneFaultBrush}" />

        </StackPanel>
    </Border>

</UserControl>
