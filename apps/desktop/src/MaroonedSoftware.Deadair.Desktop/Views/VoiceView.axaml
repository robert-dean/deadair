<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:views="using:MaroonedSoftware.Deadair.Desktop.Views"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.VoiceView"
    x:DataType="vm:VoiceViewModel">

    <DockPanel Margin="{DynamicResource DaPageGutter}" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,14">
            <TextBlock Classes="h1" Text="Voice" />

            <!-- Wraps rather than scrolling sideways: the strip is ten tabs long, and at the window's
                 minimum a row that ran off the page would hide the tabs somebody came for. -->
            <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Button Classes="tab" Classes.active="{Binding IsCharacters}" Content="Characters"
                        Command="{Binding ShowTabCommand}" CommandParameter="Characters" />
                <Button Classes="tab" Classes.active="{Binding IsAuditions}" Content="Auditions"
                        Command="{Binding ShowTabCommand}" CommandParameter="Auditions" />
                <Button Classes="tab" Classes.active="{Binding IsVoices}" Content="Voices"
                        Command="{Binding ShowTabCommand}" CommandParameter="Voices" />
                <Button Classes="tab" Classes.active="{Binding IsSegments}" Content="Segments"
                        Command="{Binding ShowTabCommand}" CommandParameter="Segments" />
                <Button Classes="tab" Classes.active="{Binding IsPronunciations}" Content="Pronunciations"
                        Command="{Binding ShowTabCommand}" CommandParameter="Pronunciations" />
                <Button Classes="tab" Classes.active="{Binding IsSoundboard}" Content="Soundboard"
                        Command="{Binding ShowTabCommand}" CommandParameter="Soundboard" />
                <Button Classes="tab" Classes.active="{Binding IsProductions}" Content="Productions"
                        Command="{Binding ShowTabCommand}" CommandParameter="Productions" />
                <Button Classes="tab" Classes.active="{Binding IsSaid}" Content="What it said"
                        Command="{Binding ShowTabCommand}" CommandParameter="Said" />
            </WrapPanel>
        </StackPanel>

        <!-- One view per tab over its own view model. The visibility is on a wrapper rather than on
             the tab itself, because setting DataContext on an element re-scopes every binding on it,
             IsVisible included. -->
        <Panel>
            <Panel IsVisible="{Binding IsCharacters}">
                <views:VoiceCharactersTab DataContext="{Binding Characters}" />
            </Panel>
            <Panel IsVisible="{Binding IsAuditions}">
                <views:VoiceAuditionsTab DataContext="{Binding Auditions}" />
            </Panel>
            <Panel IsVisible="{Binding IsVoices}">
                <views:VoiceVoicesTab DataContext="{Binding Voices}" />
            </Panel>
            <Panel IsVisible="{Binding IsSegments}">
                <views:VoiceSegmentsTab DataContext="{Binding Segments}" />
            </Panel>
            <Panel IsVisible="{Binding IsPronunciations}">
                <views:VoicePronunciationsTab DataContext="{Binding Pronunciations}" />
            </Panel>
            <Panel IsVisible="{Binding IsSoundboard}">
                <views:VoiceSoundboardTab DataContext="{Binding Soundboard}" />
            </Panel>
            <Panel IsVisible="{Binding IsProductions}">
                <views:VoiceProductionsTab DataContext="{Binding Productions}" />
            </Panel>
            <Panel IsVisible="{Binding IsSaid}">
                <views:VoiceScriptsTab DataContext="{Binding Scripts}" />
            </Panel>
        </Panel>

    </DockPanel>

</UserControl>
