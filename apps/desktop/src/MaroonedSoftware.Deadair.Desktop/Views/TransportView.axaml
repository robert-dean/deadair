<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:conv="using:MaroonedSoftware.Deadair.Desktop.Themes"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.TransportView"
    x:DataType="vm:TransportViewModel">

    <UserControl.Resources>
        <conv:ToneBrushConverter x:Key="ToneBrush" />
    </UserControl.Resources>

    <StackPanel Spacing="12" IsVisible="{Binding IsOperator}">

        <TextBlock Text="The desk" FontWeight="SemiBold" Foreground="{DynamicResource DaTextBrush}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Skip" Command="{Binding SkipCommand}" IsEnabled="{Binding StreamUp}" />
            <!-- Two presses. Stop takes the station off air, there is no undo, and it sits beside
                 Skip. -->
            <Button Content="{Binding StopLabel}" Command="{Binding StopCommand}" IsVisible="{Binding OnAir}" />
            <Button Content="Start" Command="{Binding StartCommand}" IsVisible="{Binding !OnAir}" />
        </StackPanel>

        <!-- The station's own account of why it is quiet, in the station's own words. The client
             chooses a colour and changes nothing else. -->
        <Border IsVisible="{Binding ShowSilence}" Padding="12" CornerRadius="3"
                Background="{DynamicResource DaRaisedBrush}"
                BorderBrush="{DynamicResource DaBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{Binding SilenceTone, Converter={StaticResource ToneBrush}}" />
                    <TextBlock Text="{Binding Silence}" TextWrapping="Wrap"
                               Foreground="{DynamicResource DaTextBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Remedy}" TextWrapping="Wrap" FontSize="12"
                           IsVisible="{Binding Remedy, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Foreground="{DynamicResource DaTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" FontSize="12"
                   IsVisible="{Binding NoticeText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="{DynamicResource DaToneFaultBrush}" />

        <TextBlock FontSize="12" Foreground="{DynamicResource DaTextDimmedBrush}">
            <Run Text="{Binding Queued}" />
            <Run Text="items queued" />
        </TextBlock>

    </StackPanel>

</UserControl>
