// Foundational namespaces. `user` is a leaf — it only appears as the namespace
// of subjects in other tuples.
//
// `platform` has three role tiers: viewer (view-only), admin
// (view + edit), owner (view + edit + manage). Adding further relations later
// is non-breaking — existing tuples keep working.

namespace user {
}

namespace platform {
  relation viewer: user
  relation admin:  user
  relation owner:  user

  permission view   = viewer | admin | owner
  permission edit   = admin | owner
  permission manage = owner
}
