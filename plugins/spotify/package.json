        "format": "prettier --write ."
    },
    "dependencies": {
        "@deadair/plugin-sdk": "workspace:*"
    },
    "peerDependencies": {
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "zod": "^4.4.3"
    }
