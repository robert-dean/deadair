<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:views="using:MaroonedSoftware.Deadair.Desktop.Views"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.ProgrammeView"
    x:DataType="vm:ProgrammeViewModel">

    <DockPanel Margin="{DynamicResource DaPageGutter}" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,14">
            <TextBlock Classes="h1" Text="Programme" />

            <!-- The web console's tabs, in the order the questions are asked. -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="tab" Classes.active="{Binding IsToday}" Content="Today"
                        Command="{Binding ShowTabCommand}" CommandParameter="Today" />
                <Button Classes="tab" Classes.active="{Binding IsTimetable}" Content="Timetable"
                        Command="{Binding ShowTabCommand}" CommandParameter="Timetable" />
            </StackPanel>
        </StackPanel>

        <Panel>
            <views:TodayTab DataContext="{Binding Today}" IsVisible="{Binding $parent[views:ProgrammeView].((vm:ProgrammeViewModel)DataContext).IsToday}" />

            <views:TimetableTab DataContext="{Binding Timetable}" IsVisible="{Binding $parent[views:ProgrammeView].((vm:ProgrammeViewModel)DataContext).IsTimetable}" />
        </Panel>

    </DockPanel>

</UserControl>
