#!/bin/sh -e
# What the speech server reads in: its voices, and the weights underneath them.
#
# Both ship inside the server's own tree, which is part of the image and therefore replaced on
# every update. An operator who adds a voice puts it somewhere that survives that, and the weights
# are a few hundred megabytes that should not be fetched again because the station was upgraded.
# So each is seeded out to the volume once and the tree points back at it — which is the same
# arrangement the separate-containers deployment used, for the same reason.

DATA="${DATA_DIR:-/data}"

# The weights are derived — fetched from somebody else's server, reproducible by asking again — so
# they go with the rest of the derived half rather than beside the settings. The voices do not:
# the shipped ones are replaceable, but an operator who adds a clip of their own has authored it.
# shellcheck source=/dev/null
. /etc/s6-overlay/scripts/storage-env

[ -d /opt/tts ] || exit 0

# Move a directory out to the volume and leave a link behind it. Never clobbering: a voice the
# operator replaced by hand stays replaced, and weights already fetched are not fetched again.
keep() {
    shipped="$1"
    kept="$2"

    mkdir -p "$kept" "$(dirname "$shipped")"

    if [ -d "$shipped" ] && [ ! -L "$shipped" ]; then
        cp -rn "$shipped"/. "$kept"/ 2>/dev/null || true
        rm -rf "$shipped"
    fi

    [ -L "$shipped" ] || ln -sfn "$kept" "$shipped"
    chown -R 99:100 "$kept" 2>/dev/null || true
}

keep /opt/tts/api/src/voices/v1_0 "$DATA/voices"
# The weights are fetched on first use when the image ships none, so this may be an empty
# directory the server fills in later. It still has to be the volume's rather than the image's.
keep /opt/tts/api/src/models "$DEADAIR_MEDIA/tts-models"
