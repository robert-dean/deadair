<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.VoicePronunciationsTab"
    x:DataType="vm:PronunciationsViewModel">

    <UserControl.DataTemplates>
        <!-- The name, what it becomes, and the sentence it came from when nobody here typed it. The
             actions differ by section, so each is shown only in its own. -->
        <DataTemplate DataType="vm:PronunciationRowViewModel">
            <Grid ColumnDefinitions="*,190" ColumnSpacing="12" Margin="0,4">
                <StackPanel Spacing="2">
                    <WrapPanel ItemSpacing="8">
                        <TextBlock Text="{Binding Written}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                        <TextBlock Text="→" Classes="dimmed" />
                        <TextBlock Text="{Binding Spoken}" TextTrimming="CharacterEllipsis" MaxWidth="260" Classes.dimmed="{Binding IsDropped}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Evidence}" FontSize="11" Classes="dimmed" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceUrl}"
                               IsVisible="{Binding Evidence, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Say it this way"
                            IsVisible="{Binding IsProposed}"
                            Command="{Binding $parent[UserControl].((vm:PronunciationsViewModel)DataContext).SayCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Turn down"
                            IsVisible="{Binding IsProposed}"
                            Command="{Binding $parent[UserControl].((vm:PronunciationsViewModel)DataContext).TurnDownCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Edit"
                            IsVisible="{Binding IsActive}"
                            Command="{Binding $parent[UserControl].((vm:PronunciationsViewModel)DataContext).EditCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Delete"
                            IsVisible="{Binding IsActive}"
                            Command="{Binding $parent[UserControl].((vm:PronunciationsViewModel)DataContext).DeleteCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Say it"
                            IsVisible="{Binding IsRejected}"
                            Command="{Binding $parent[UserControl].((vm:PronunciationsViewModel)DataContext).SayCommand}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer>
        <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,14,16">
            <TextBlock Classes="dimmed" FontSize="12" TextWrapping="Wrap"
                       Text="The names the station would otherwise read wrongly. Whatever is on the right is handed to the speech engine untouched, so write it however that engine reads best, and leave it empty to drop the words entirely." />
            <TextBlock Classes="dimmed" Text="{Binding Notice}" TextWrapping="Wrap"
                       IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <Border Classes="card" IsVisible="{Binding HasProposed}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="eyebrow" Text="Proposed" />
                    <TextBlock Classes="dimmed" FontSize="11" TextWrapping="Wrap"
                               Text="Found printed in articles the station already holds. None is said until it is accepted: an article's key is often about one word of a name, and sometimes about a different name entirely." />
                    <ItemsControl ItemsSource="{Binding Proposed}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="eyebrow" Text="Said this way" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost" FontSize="12" Padding="10,3" Content="Add a name" Command="{Binding AddCommand}" />
                    </Grid>
                    <TextBlock Classes="dimmed" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"
                               Text="The station says everything as it is written. Add a name whose letters are not its sounds, and it says it your way from the next break on." />
                    <ItemsControl ItemsSource="{Binding Active}" />
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding HasTurnedDown}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="eyebrow" Text="Turned down" />
                    <TextBlock Classes="dimmed" FontSize="11" Text="Kept rather than deleted, so the same article does not propose them again." />
                    <ItemsControl ItemsSource="{Binding TurnedDown}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
