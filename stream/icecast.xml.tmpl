<?xml version="1.0" encoding="UTF-8"?>
<!--
  Icecast config TEMPLATE. This file is committed with {{TOKENS}} and contains NO
  secrets. The app renders it (filling passwords + identity from the DB settings)
  to the shared streamconfig volume as icecast.xml at boot.
  See apps/api/src/modules/stream/stream.config.ts.
-->
<icecast>
  <!-- Rendered only when the operator set stream.location. The literal "Earth" that
       used to be here is the placeholder Icecast 2.5's dashboard flags as unset, and
       it was: only the operator knows where the station broadcasts from. -->
{{LOCATION}}  <admin>{{ADMIN_EMAIL}}</admin>

  <limits>
    <clients>100</clients>
    <!-- Four format mounts (MP3 always, Opus/AAC/FLAC as the operator switches them on) plus
         headroom for a future live/harbor source. -->
    <sources>8</sources>
    <!-- SLOW-CLIENT TOLERANCE, and it is counted in BYTES rather than seconds, which is the whole
         reason it is rendered rather than written here as a literal.
         A fixed 524288 is ~32s at 128 kbps and ~4.7s at a FLAC mount's ~900 kbps, so a station
         that switched on a lossless mount would start dropping listeners the MP3 mount had been
         carrying without complaint — and the fault would present as "the new high-quality mount
         keeps cutting people off" rather than as a buffer nobody re-derived.
         So the app sizes it from the HIGHEST enabled bitrate, in seconds. See
         apps/api/src/modules/stream/stream.config.ts. -->
    <queue-size>{{QUEUE_SIZE}}</queue-size>
    <client-timeout>30</client-timeout>
    <header-timeout>15</header-timeout>
    <source-timeout>10</source-timeout>
    <!-- Burst a little buffered audio on connect so players start fast.
         The burst is BACKLOG: a listener starts that far behind the live edge and stays there for
         the whole session, so it is also how late the mount answers anything an operator does on
         air. Measured at the mount, the old 65536 was handing out ~4s of it.
         ~0.5s of it: still enough to prime a decoder on connect, and roughly the smallest that
         starts cleanly across browsers. Raise it if a player takes visibly longer to start on a
         poor connection — that is the trade this number makes, and nothing else.
         Bytes again, so it is rendered too — but from the MP3 mount's bitrate ALONE, and
         deliberately not from the highest. This is the global default and the burst is latency
         everybody pays: sizing it for a FLAC mount would hand every MP3 listener seconds of
         backlog to buy a lossless listener half of one. A mount whose own bitrate makes this
         value too short in TIME carries its own override; see the blocks below. -->
    <burst-on-connect>1</burst-on-connect>
    <burst-size>{{BURST_SIZE}}</burst-size>
  </limits>

  <authentication>
    <source-password>{{SOURCE_PASSWORD}}</source-password>
    <relay-password>{{RELAY_PASSWORD}}</relay-password>
    <admin-user>admin</admin-user>
    <admin-password>{{ADMIN_PASSWORD}}</admin-password>
  </authentication>

  <hostname>{{HOSTNAME}}</hostname>
  <listen-socket>
    <port>8000</port>
  </listen-socket>

  <!-- The public voice stream. When Liquidsoap isn't connected, listeners are
       moved to the fallback so the mount is never a dead connection. -->
  <mount type="normal">
    <!-- The SAME credential as <source-password> above, stated again here because a mount-scoped
         admin command is authorised against the mount's own username and password, and a mount
         that declares none has nothing to authorise against. The global source password is not a
         substitute: it lets a source CONNECT and nothing more.

         What that cost while this was missing, measured on 2.5.0: /admin/metadata answered 401 to
         the source credential AND to the admin one, so every ICY metadata update Liquidsoap made
         was refused. For an MP3 mount that update IS the metadata path — there is no in-band one
         for a source client — so the app's own labelling endpoint (POST /control/metadata, which
         exists because this graph has two switches that move mid-track and drop a label emitted
         while another branch is selected) returned 200 from Liquidsoap and then silently changed
         nothing on the mount. A listener's player showed whatever it had last been told, which on
         a station that had just come back on air mid-record was a track that was no longer playing.

         `source` is Liquidsoap's own default for output.icecast's `user`, which radio.liq does not
         override. The two have to match: this is the other half of that pair. -->
    <username>source</username>
    <password>{{SOURCE_PASSWORD}}</password>
    <mount-name>{{MOUNT}}</mount-name>
    <stream-name>{{STREAM_NAME}}</stream-name>
    <stream-description>{{STREAM_DESCRIPTION}}</stream-description>
    <genre>{{STREAM_GENRE}}</genre>
    <stream-url>{{STREAM_URL}}</stream-url>
    <!-- Don't auto-advertise to public YP directories yet. -->
    <public>0</public>
    <!-- No <authentication type="url"> here, deliberately. The app used to have Icecast call it on
         every listener_add and listener_remove, which made a listener's own connection wait on the
         API and let a dead API refuse new listeners at the door. It is not needed: /admin/eventfeed
         carries `source-listeners-changed` on every change in either direction with an authoritative
         count, so both edges are already known without holding anybody's connection open. -->
  </mount>

  <!-- The optional format mounts: one block per format the operator switched on, and nothing at
       all when none is. Rendered, because which of them exist is a setting.

       Each carries its OWN credentials rather than inheriting them. Icecast does have a
       default-typed mount block for exactly this, and it was the obvious way to write it — but a
       default block does not merge with a normal-typed one, so it would have had to cover the
       optional mounts while the MP3 mount above kept its own copy anyway, and it could not give
       a FLAC mount the longer burst it needs without handing the same burst to Opus and AAC.
       One self-contained block per mount costs some repetition in a file nobody hand-edits and
       makes each mount's numbers its own.
       (Written without angle brackets on purpose: a mount element quoted in prose is one a grep
       for the mounts this file declares would count as a real one, and one such grep is the test
       that holds this file to the number of mounts the settings asked for.)

       Credentials at all, rather than none, because a mount that declares none has nothing to
       authorise a mount-scoped admin command against: /admin/metadata answers 401 to the source
       password AND the admin one, and every ICY title update for that mount is silently refused.
       That is the failure the block above records at length, and it would come straight back on
       three new mounts at once. -->
{{EXTRA_MOUNTS}}

  <fileserve>1</fileserve>
  <!-- Paths match the libretime/icecast image (built from source, prefix /usr,
       localstatedir /var), NOT the Debian icecast2 package layout. The container
       runs as the non-root `icecast` user, which owns /var/log/icecast; using
       /var/log/icecast2 would fail to open the log and icecast would exit. -->
  <paths>
    <logdir>/var/log/icecast</logdir>
    <webroot>/usr/share/icecast/web</webroot>
    <adminroot>/usr/share/icecast/admin</adminroot>
  </paths>

  <logging>
    <loglevel>3</loglevel>
  </logging>
</icecast>
