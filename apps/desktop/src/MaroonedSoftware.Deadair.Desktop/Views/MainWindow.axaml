<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:views="using:MaroonedSoftware.Deadair.Desktop.Views"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.MainWindow"
    x:DataType="vm:ShellViewModel"
    Title="deadair"
    Icon="avares://deadair/Assets/logo-mark.png"
    Width="1180"
    Height="720"
    MinWidth="820"
    MinHeight="520"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="38"
    Background="{DynamicResource DaBgBrush}">

    <Panel>
        <!-- Setup sits ABOVE the rest rather than being a page you can navigate away from: an app
             with no station cannot do anything else yet. -->
        <views:SetupView DataContext="{Binding Setup}"
                         IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).NeedsStation}" />

        <Grid IsVisible="{Binding !NeedsStation}" RowDefinitions="*,Auto">
            <Grid ColumnDefinitions="220,*">
                <!-- Given the shell rather than the navigation: the sidebar draws the account too,
                     and a control that needs two view models is better handed the one that owns
                     both than made to hop back up through the window for the second. -->
                <views:Sidebar DataContext="{Binding}" />

                <!-- The pages, one at a time. Each is built once and keeps its own DataContext, so
                     nothing inside a page has to reach the window to find its own view model. -->
                <views:PageHost Grid.Column="1" Shell="{Binding}" />
            </Grid>

            <!-- On every page, because what is playing is not a page. -->
            <views:PlayerBar Grid.Row="1" DataContext="{Binding Listener}" />
        </Grid>
    </Panel>

</Window>
