# deadair — production environment.
#
# Copy to `.env` beside the compose file and fill in. Everything the station does at runtime is
# configured from the console and stored in the database; what is here is only what has to be
# known before there is a database to read.

# ─── Which image, and where it listens ────────────────────────────────────────────────────────
# latest = speech server bundled, database and cache are yours.
# full   = database and cache bundled too. Nothing else needed on the host.
# slim   = no speech server either; point the speech plugin at your own.
VARIANT=latest
# The published port. Serves the console, /api, and the stream at /live.mp3.
HTTP_PORT=8080
# Where the station keeps everything. Back this up.
DATA_DIR=./data

# ─── Database ─────────────────────────────────────────────────────────────────────────────────
# Required on `latest` and `slim`; ignored on `full`, which runs its own.
# This role owns the schema: migrations run as it on every boot.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=deadair
# Optional. A second, non-owner role for the runtime pool, holding DML grants only, so the
# request path cannot alter the schema. Leave both blank to run everything as the owner.
DATABASE_APP_USER=
DATABASE_APP_PASSWORD=

# Set to false only if you apply migrations yourself. Left on, the station brings its own schema
# up to date at every boot — an out-of-date schema otherwise degrades quietly rather than failing.
MIGRATE_ON_BOOT=true

# ─── Cache ────────────────────────────────────────────────────────────────────────────────────
# Sessions and refresh-token families live here rather than in the database. Required on
# `latest` and `slim`; ignored on `full`.
REDIS_HOST=
REDIS_PORT=6379

# ─── Secrets ──────────────────────────────────────────────────────────────────────────────────
# Generate once, keep forever, back up. The first encrypts every credential the station stores
# (provider tokens, stream passwords); losing it means re-entering all of them. The second signs
# sessions; losing it signs everybody out and nothing worse.
#
# Hex, and it must be hex: it is read as hex bytes, so a base64 key is silently a different and
# much weaker key than the one you thought you generated.
#
#     openssl rand -hex 32
#
KMS_LOCAL_ROOT_KEY=
#
# An RSA private key in PEM. Sessions are signed RS256, so an elliptic-curve key is refused.
#
#     openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
#
# Compose reads a multi-line value only when it is quoted, so keep it on one line with \n for the
# newlines, or point the container at a file and pass the contents in yourself.
AUTHENTICATION_SESSION_JWT_PRIVATE_KEY=

# ─── Addresses ────────────────────────────────────────────────────────────────────────────────
# How the station is reached from outside — used to build sign-in redirects, so they must be the
# URL a browser actually visits, not the container's own. Both are the same address here, because
# one port serves both the console and the API.
APP_BASE_URL=https://radio.example.com
SPA_BASE_URL=https://radio.example.com

# ─── Sign-in ──────────────────────────────────────────────────────────────────────────────────
# Optional. Without these the station falls back to its one-time-code sign-in.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

# Nothing else belongs here. In particular the log-rotation limits (LOG_MAX_*) are deliberately
# absent: they are validated strictly and a value the parser cannot read stops the station at
# boot, which is a poor trade for a setting almost nobody changes.
