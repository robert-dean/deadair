#!/bin/sh
# Neither the stream server nor the audio chain re-reads its config, so something has to notice
# when the app has written a new one and restart the two that care. It also carries the station's
# request to restart an audio chain that has stopped playing: see `restart_request` below.
#
# In the compose deployment this stopped the container and let the restart policy bring it back,
# because there the container WAS the process. Here the supervisor is one level up and can restart
# exactly the two services whose config changed, which is the same mechanism doing less damage:
# a stream password rotating no longer takes the whole station down with it.
#
# It polls. That is not laziness — file-change events do not cross a bind mount reliably, which
# is exactly what /data is, and the cost of being five seconds late to a config change nobody is
# watching is nothing.
exec 2>&1

interval="${CONFIG_WATCH_INTERVAL_S:-5}"
case "$interval" in
    '' | 0)
        echo "config-watch: disabled; a re-rendered config is adopted when this container restarts"
        # A service that exits is a service the supervisor restarts. Sleep instead, doing nothing.
        exec sleep infinity
        ;;
esac

mtime() { stat -c %Y "$1" 2>/dev/null || true; }

# The audio chain is restarted DOWN-then-UP rather than with `-r`, and the difference is the whole
# point. `-r` sends the stop signal and waits for the process to exit on its own; the supervisor
# escalates to a kill only for a service taken DOWN (`-d`), after the `timeout-kill` in its service
# directory. Measured against this image's s6-overlay: a service ignoring the stop signal survived
# `-ruwr` indefinitely, and `-wD -d` killed it at the timeout. On 2026-09-13 Liquidsoap was exactly
# that service, stuck in its own shutdown, and a `-r` would have left this loop waiting behind it.
restart_audio_chain() {
    s6-svc -wD -d /run/service/liquidsoap && s6-svc -wu -u /run/service/liquidsoap
}

icecast_config=/data/streamconfig/icecast.xml
radio_config=/data/streamconfig/radio.env
# Not a config: the station asking for the audio chain to be restarted because it has stopped
# playing what it is handed. The app has no business holding a supervisor's control socket, so it
# says so the way it already says everything else this loop acts on, by writing a file here. Only
# the mtime is read, exactly as for the other two. Only Liquidsoap goes: the shim's config has not
# changed, and restarting it would cost its session for nothing.
restart_request=/data/streamconfig/liquidsoap.restart

# What was true when the services below us started. A file appearing for the first time is a
# change like any other: on a cold station it is THE change, the one where the settings the
# operator entered replace the committed defaults. For the restart request the same rule means a
# file left from before this container started is history, and only a new write is a request.
icecast_seen=$(mtime "$icecast_config")
radio_seen=$(mtime "$radio_config")
restart_seen=$(mtime "$restart_request")

echo "config-watch: watching every ${interval}s"

while sleep "$interval"; do
    icecast_now=$(mtime "$icecast_config")
    radio_now=$(mtime "$radio_config")
    restart_now=$(mtime "$restart_request")

    # Only act once the file has stopped moving: the app writes by rename, and a restart raced
    # against a half-written config is a station that reads the wrong one and stays wrong.
    if [ "$icecast_now" != "$icecast_seen" ] && [ "$icecast_now" = "$icecast_previous" ]; then
        echo "config-watch: the stream server's config changed; restarting it"
        icecast_seen="$icecast_now"
        s6-svc -ruwr /run/service/icecast || echo "config-watch: could not restart the stream server" >&2
    fi

    if [ "$radio_now" != "$radio_seen" ] && [ "$radio_now" = "$radio_previous" ]; then
        echo "config-watch: the audio chain's config changed; restarting it"
        radio_seen="$radio_now"
        restart_audio_chain || echo "config-watch: could not restart the audio chain" >&2
        s6-svc -ruwr /run/service/shim || echo "config-watch: could not restart the track shim" >&2
        # That restart answers any request that arrived with it. A second one straight after
        # would cut the fresh process for nothing.
        restart_seen="$restart_now"
    fi

    if [ "$restart_now" != "$restart_seen" ] && [ "$restart_now" = "$restart_previous" ]; then
        echo "config-watch: the station asked for the audio chain to be restarted; restarting it"
        restart_seen="$restart_now"
        restart_audio_chain || echo "config-watch: could not restart the audio chain" >&2
    fi

    icecast_previous="$icecast_now"
    radio_previous="$radio_now"
    restart_previous="$restart_now"
done
