{
    "extends": "@repo/config-typescript/react.json",
    "compilerOptions": {
        "noEmit": true,
        // Docusaurus's own ambient modules (`@theme/*`, `@docusaurus/*`, CSS modules) in place of
        // the React config's `vite/client`, which this package does not have.
        "types": ["node", "@docusaurus/module-type-aliases", "@docusaurus/theme-classic"]
    },
    "include": ["./src/**/*", "./docusaurus.config.ts"],
    "exclude": ["node_modules", "dist", ".docusaurus"]
}
