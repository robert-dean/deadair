<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <RootNamespace>MaroonedSoftware.Deadair.Desktop</RootNamespace>
        <AssemblyName>deadair</AssemblyName>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <!-- Avalonia's own targets add the XAML and the application icon, and nothing else, so the
             fonts and the icon licence are invisible to `avares://` without this. A missing entry
             here does not fail the build: the font silently falls back to the system face. -->
        <AvaloniaResource Include="Assets/**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The bundled plugins. `BundledPlugin` is this tree's own item, defined in
            Directory.Build.targets: each one is built before the app and copied whole into
            plugins/<id>/ beside it, and the app never compiles against any of them. That is
            deliberate. If the app could name a type from a plugin it ships, the bundled one would
            work through a path nothing else uses and the third-party path would rot unnoticed.
        -->
        <BundledPlugin Include="../../plugins/bluos/src/MaroonedSoftware.Deadair.Desktop.Plugins.BluOs/MaroonedSoftware.Deadair.Desktop.Plugins.BluOs.csproj"
                       PluginId="deadair.bluos" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../MaroonedSoftware.Deadair.Desktop.Core/MaroonedSoftware.Deadair.Desktop.Core.csproj" />
        <ProjectReference Include="../MaroonedSoftware.Deadair.Desktop.Player.Mac/MaroonedSoftware.Deadair.Desktop.Player.Mac.csproj" />
    </ItemGroup>

</Project>
