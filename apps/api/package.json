{
    "name": "@deadair/api",
    "private": true,
    "type": "module",
    "main": "index.ts",
    "scripts": {
        "dev": "NODE_ENV=development node --inspect --no-warnings --no-deprecation --import @swc-node/register/esm-register --enable-source-maps --watch --watch-preserve-output ./src/index.ts",
        "build": "NODE_OPTIONS=--max_old_space_size=8192 tsc",
        "build:data": "echo 'build:data orchestrated by turbo (migrate:up -> build:datatypes)'",
        "codegen": "echo 'codegen orchestrated by turbo (build:data + build:contracts + build:permissions)'",
        "rebuild:data": "pnpm migrate:down:all && pnpm migrate:up && pnpm build:datatypes",
        "build:contracts": "contractkit",
        "build:permissions": "pdsl",
        "build:datatypes": "pnpm sync:enum-overrides && kysely-codegen",
        "sync:enum-overrides": "node --no-warnings --import @swc-node/register/esm-register scripts/sync.enum.overrides.ts",
        "migrate:up": "dbmate -d ./data/migrations --no-dump-schema up",
        "migrate:down": "dbmate -d ./data/migrations --no-dump-schema down",
        "migrate:down:all": "./scripts/rollbackall.sh",
        "migrate:create": "dbmate -d ./data/migrations new",
        "lint": "eslint --fix",
        "typecheck": "tsc --noEmit -p tsconfig.tests.json",
        "format": "prettier --write . --ignore-path ../../.prettierignore",
        "test": "vitest run"
    },
    "dependencies": {
        "@deadair/error-codes": "workspace:*",
        "@deadair/plugin-sdk": "workspace:*",
        "@maroonedsoftware/appconfig": "^2.4.1",
        "@maroonedsoftware/authentication": "^4.30.1",
        "@maroonedsoftware/cache": "^0.4.0",
        "@maroonedsoftware/encryption": "^0.5.5",
        "@maroonedsoftware/errors": "^1.8.0",
        "@maroonedsoftware/eventbus": "^0.1.2",
        "@maroonedsoftware/jobbroker": "^1.11.0",
        "@maroonedsoftware/koa": "^3.0.3",
        "@maroonedsoftware/kysely": "^0.7.3",
        "@maroonedsoftware/logger": "^1.1.3",
        "@maroonedsoftware/permissions": "^0.2.3",
        "@maroonedsoftware/policies": "^0.6.0",
        "@maroonedsoftware/serverfeed": "^0.1.0",
        "@maroonedsoftware/utilities": "^1.11.0",
        "@maroonedsoftware/zod": "^0.5.0",
        "injectkit": "^1.6.0",
        "ioredis": "^6.0.0",
        "koa": "^3.2.1",
        "kysely": "^0.29.4",
        "luxon": "^3.7.2",
        "pg": "^8.22.0",
        "pg-boss": "^12.27.0",
        "rate-limiter-flexible": "^11.2.0",
        "reflect-metadata": "^0.2.2",
        "rotating-file-stream": "^3.2.9",
        "semver": "^7.8.5",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@contractkit/cli": "^0.10.4",
        "@contractkit/plugin-typescript": "^0.30.0",
        "@deadair/plugin-musicbrainz": "workspace:*",
        "@deadair/plugin-spotify": "workspace:*",
        "@maroonedsoftware/permissions-dsl": "^0.5.0",
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.15.47",
        "@types/koa": "^3.0.3",
        "@types/koa__router": "^12.0.5",
        "@types/luxon": "^3.7.3",
        "@types/node": "^26.1.2",
        "@types/pg": "^8.20.3",
        "@types/semver": "^7.8.0",
        "dbmate": "^2.34.1",
        "kysely-codegen": "^0.20.0",
        "prettier": "^3.9.6",
        "typescript": "6.0.3"
    }
}
