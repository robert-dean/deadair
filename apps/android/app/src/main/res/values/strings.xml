<?xml version="1.0" encoding="utf-8"?>
<!--
    Every word the app says. The Kotlin that decides WHAT to say returns a `Message` and never a
    sentence, so this file is the only place a sentence lives; see `ui/text/Message.kt`.
-->
<resources>
    <string name="app_name">deadair</string>

    <!-- The frame -->
    <string name="tab_now_playing">Now playing</string>
    <string name="tab_history">Played</string>
    <string name="tab_whats_on">What\'s on</string>
    <string name="settings">Settings</string>
    <string name="back">Back</string>

    <!-- Now playing -->
    <string name="now_warming_up">Warming up</string>
    <string name="now_off_air">Off air</string>
    <string name="now_cant_reach">Can\'t reach the station</string>
    <string name="now_quiet_until_someone_tunes_in">Quiet until someone tunes in — press play to start it.</string>
    <string name="now_coming_on_air">The station is coming on air</string>
