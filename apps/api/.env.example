# A development checkout's environment. Copy to `apps/api/.env` and fill in the two keys:
#
#     cp apps/api/.env.example apps/api/.env
#
# The values below match the services in the repository's root `docker-compose.yml`, so they are
# right as they stand for `docker compose up -d` on this machine. `apps/api/.env` is gitignored.
#
# This file is for a checkout you develop in. Running a station is `deploy/.env.example` instead,
# which is production-shaped and asks for different things.

# The database, twice, because two kinds of tool read it and they disagree about the shape.
# DATABASE_URL is for the ones that are not the station: dbmate, which applies the migrations
# (`pnpm migrate:up`), and kysely-codegen, which walks the schema (`pnpm build:datatypes`) and is
# pointed at this file by `apps/api/.kysely-codegenrc.json`. The discrete values below are what the
# station itself connects with. Keep them saying the same thing.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/deadair?sslmode=disable

# 55432 rather than 5432: the compose file publishes Postgres there so it cannot collide with a
# PostgreSQL already running on this machine.
DATABASE_HOST=localhost
DATABASE_PORT=55432
DATABASE_NAME=deadair
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379

# What `pnpm dev` serves the API on. The console's dev server proxies `/api` here, and hard-codes
# this port in `apps/web/vite.config.ts`, so changing it means changing that too.
PORT=3333

NODE_ENV=development
LOG_LEVEL=debug

# Generate both. The station refuses to start without either, on purpose: one encrypts every
# credential it stores and the other signs every session, and a default value for either would be
# a published secret.
#
#     openssl rand -hex 32
#
# Hex, and read as hex bytes: a base64 string of the same length is quietly a much weaker key.
KMS_LOCAL_ROOT_KEY=

#     openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
#
# RSA, because sessions are signed RS256. The key is accepted as the PEM, as the PEM with its line
# breaks written `\n`, or base64-ed onto one line, which is the shape that survives an env file.
# On macOS the last command is `base64` with no `-w0`.
AUTHENTICATION_SESSION_JWT_PRIVATE_KEY=

# Where a browser reaches this checkout. Vite serves the console on 3002, and these are what the
# station puts in a sign-in email and hands a music provider to come back to; nothing else depends
# on them, so a wrong value leaves the console working and those two landing nowhere.
APP_BASE_URL=http://localhost:3002
SPA_BASE_URL=http://localhost:3002

# Accepts any six-digit code at an OTP prompt, so an authenticator is not needed to walk a sign-in.
# It refuses to start unless NODE_ENV=development, and the station says loudly at boot that it is on.
# Sign-in mail has somewhere to go without this: compose runs Mailpit, whose inbox is on
# http://localhost:8025 (Settings, Mail: host `localhost`, port 1025, TLS off, no username).
OTP_DEV_BYPASS=false

# Where the station looks for operator-installed plugins, relative to `apps/api`. The default is
# `./data/plugins`, which is gitignored and does not exist in a fresh checkout: create it before
# linking a plugin of your own into it.
# PLUGINS_DIR=./data/plugins
