<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:conv="using:MaroonedSoftware.Deadair.Desktop.Themes"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.LoginView"
    x:DataType="vm:LoginViewModel">

    <StackPanel Spacing="10" Margin="16">

        <TextBlock Classes="h3" Text="Sign in as the operator" />
        <TextBlock Classes="dimmed" TextWrapping="Wrap"
                   Text="Listening needs no account. This is for the desk." />

        <StackPanel Spacing="8" IsVisible="{Binding !NeedsCode}">
            <TextBox Text="{Binding Email}" PlaceholderText="you@example.com" IsEnabled="{Binding !Busy}" />
            <!--
                The reveal is here because a password almost never gets TYPED into this box. No
                password manager can fill it: the app exposes no text field to the accessibility
                API that 1Password's autofill looks through, so the way one arrives is a paste —
                and a pasted secret you cannot read is one you cannot check before pressing Sign in.

                Copy out of a masked box is blocked by Avalonia and paste into one is not, which is
                exactly the right way round and is why this is the whole fix rather than half of it.
            -->
            <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="•"
                     PlaceholderText="Password" IsEnabled="{Binding !Busy}">
                <TextBox.InnerRightContent>
                    <ToggleButton x:Name="RevealToggle" Classes="icon small" Margin="0,0,4,0"
                                  ToolTip.Tip="Show the password">
                        <PathIcon Width="15" Height="15"
                                  Data="{Binding #RevealToggle.IsChecked, Converter={x:Static conv:RevealIconConverter.Instance}}" />
                    </ToggleButton>
                </TextBox.InnerRightContent>
            </TextBox>
        </StackPanel>

        <!-- The second factor is a 200 rather than an error, so this is a continuation of the same
             sign-in and keeps the email rather than starting again. -->
        <StackPanel Spacing="8" IsVisible="{Binding NeedsCode}">
            <TextBlock Text="Enter the code from your authenticator." FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource DaTextSecondaryBrush}" />
            <TextBox Text="{Binding Code}" PlaceholderText="000000" FontFamily="{DynamicResource DaFontMono}"
                     MaxLength="6" IsEnabled="{Binding !Busy}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Classes="ghost" Content="Back" Command="{Binding CancelCommand}" IsVisible="{Binding NeedsCode}"
                    HorizontalAlignment="Left" />
            <Button Grid.Column="1" Classes="primary" Content="Sign in" Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding !Busy}" />
        </Grid>

        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap"
                   IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="{DynamicResource DaToneFaultBrush}" />

    </StackPanel>

</UserControl>
