<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:views="using:MaroonedSoftware.Deadair.Desktop.Views"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:controls="using:MaroonedSoftware.Deadair.Desktop.Controls"
    xmlns:conv="using:MaroonedSoftware.Deadair.Desktop.Themes"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.ShellView"
    x:DataType="vm:ShellViewModel">

    <!--
        Everything in the window but the setup screen, as one control.

        Its own control so that the screenshot tool (tools/Shots) renders THIS rather than a copy of
        it: a Window cannot be the content of another window, so the tool used to rebuild the layout
        by hand, and a copy is a thing that goes out of step the first time the layout moves.
    -->
    <UserControl.Resources>
        <conv:ToneBrushConverter x:Key="ToneBrush" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Below this the page would be narrower than the panel beside it. -->
        <ContainerQuery Name="Shell" Query="max-width:1060">
            <Style Selector="Border.nowplaying">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ContainerQuery>

        <!-- The Playing on strip: the accent, solid, with the words on it in the accent's own text
             colour, and a shade darker under the pointer so it reads as something to press. -->
        <Style Selector="Button.playingon">
            <Setter Property="Background" Value="{DynamicResource DaAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DaOnAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.playingon /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DaAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DaOnAccentBrush}" />
        </Style>
        <Style Selector="Button.playingon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DaAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DaOnAccentBrush}" />
            <Setter Property="Opacity" Value="0.88" />
        </Style>
    </UserControl.Styles>

    <!-- The shell: a title row, then the sidebar, the page and Now playing as rounded panels with
         the window showing between them, then the bar on the window itself. -->
    <Grid RowDefinitions="38,Auto,*,Auto">

        <!-- The window's client area runs under the title bar, so this row is where the traffic
             lights sit and is the region the window is dragged by. 80px of padding is the room
             they need; `WindowDecorationMargin` could say so exactly, but it reads as zero in a
             headless render and the layout must not differ between what is drawn and what is
             looked at. The wordmark sits here rather than in the sidebar, which is now a panel
             below the row rather than the thing the row belongs to. -->
        <Border Padding="80,0,12,0" chrome:WindowDecorationProperties.ElementRole="TitleBar"
                Background="{DynamicResource DaBgBrush}">
            <TextBlock Text="deadair" FontSize="15" FontWeight="Bold" LetterSpacing="1.4"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource DaAccentBrush}" />
        </Border>

        <!-- Docked rather than a grid, so a panel that is put away takes its gap with it: a grid's
             column spacing stays whether or not the column has anything in it. A container, so the
             Now playing panel stands down on its own below 1060 (see the query above) and the page
             keeps enough room to be a page; that hides it without touching what was chosen. -->
        <!-- Where the sound is going, while it is going somewhere other than this Mac: the speaker's
             name in words across the top, so somebody across the room can see it without hovering
             over the bar's icon. A click opens the same picker the bar's speaker button does. It
             says nothing on its own, never moves playback, and a speaker missing from the last scan
             is said to be missing (PlayingOnStrip). -->
        <Button x:Name="PlayingOnStrip" Grid.Row="1" Classes="playingon" Margin="8,0,8,8"
                IsVisible="{Binding Listener.PlayingOnCaption, Converter={x:Static ObjectConverters.IsNotNull}}"
                AutomationProperties.Name="{Binding Listener.PlayingOnCaption}"
                ToolTip.Tip="Choose where the station plays">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{DynamicResource DaIconSpeaker}" Width="12" Height="12" />
                <TextBlock Text="{Binding Listener.PlayingOnCaption}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button.Flyout>
                <Flyout Placement="Bottom" ShowMode="Standard">
                    <views:OutputPicker Width="268" DataContext="{Binding Listener.Outputs}" />
                </Flyout>
            </Button.Flyout>
        </Button>

        <DockPanel Grid.Row="2" Margin="8,0,8,0" Container.Name="Shell" Container.Sizing="Width">
            <!-- Given the shell rather than the navigation: the sidebar draws the account too, and a
                 control that needs two view models is better handed the one that owns both than made
                 to hop back up through the window for the second. -->
            <Border DockPanel.Dock="Left" Classes="panel" Width="220" Margin="0,0,8,0">
                <views:Sidebar DataContext="{Binding}" />
            </Border>

            <Panel DockPanel.Dock="Right" IsVisible="{Binding ShowNowPlaying}">
                <Border Classes="panel nowplaying" Width="320" Margin="8,0,0,0">
                    <views:NowPlayingPanel />
                </Border>
            </Panel>

            <!-- The pages, one at a time. Each is built once and keeps its own DataContext, so
                 nothing inside a page has to reach the window to find its own view model. -->
            <!-- Under the page, the on-air cover's colour washed down its top (CoverWash), as a web
                 player heads its pages. Behind every page rather than the desk alone, so moving
                 between pages keeps the record's colour on screen. -->
            <Border Classes="panel">
                <Panel>
                    <controls:CoverWash VerticalAlignment="Top" Height="320"
                                        Palette="{Binding Listener.CoverPalette}" />
                    <!-- Back sits over the page's own gutter, above its heading, and only on a
                         detail page: the rail's pages are where Back would go, never where it starts. -->
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Classes="ghost" HorizontalAlignment="Left"
                                Margin="20,12,0,-20" Padding="6,3" FontSize="12"
                                IsVisible="{Binding Navigation.CanGoBack}"
                                Command="{Binding Navigation.BackCommand}"
                                ToolTip.Tip="Back (⌘[)" AutomationProperties.Name="Back">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{DynamicResource DaIconChevronRight}" Width="12" Height="12">
                                    <PathIcon.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </PathIcon.RenderTransform>
                                </PathIcon>
                                <TextBlock Text="Back" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- What the station last refused, or answered, at the foot of whichever page asked. -->
                        <Border DockPanel.Dock="Bottom" Classes="card" Margin="20,0,20,16" Padding="12,8"
                                IsVisible="{Binding Dialogs.HasNotice}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="{Binding Dialogs.Notice}" TextWrapping="Wrap" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Dialogs.NoticeTone, Converter={StaticResource ToneBrush}}" />
                                <Button Grid.Column="1" Classes="icon ghost" Width="24" Height="24" Padding="4"
                                        BorderThickness="0" ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss"
                                        Command="{Binding Dialogs.DismissNoticeCommand}">
                                    <PathIcon Data="{DynamicResource DaIconClose}" Width="12" Height="12" />
                                </Button>
                            </Grid>
                        </Border>
                        <views:PageHost x:Name="Pages" Shell="{Binding}" />
                    </DockPanel>
                </Panel>
            </Border>
        </DockPanel>

        <!-- On every page, because what is playing is not a page. On the window rather than in
             a panel of its own, as a player's bar is. -->
        <views:PlayerBar Grid.Row="3" DataContext="{Binding Listener}" />

        <!-- Studio, over the whole window, bar included: it is the record on air and nothing else.
             Under the dialogs, so a question asked while it is up is still seen. -->
        <views:StudioView Grid.RowSpan="4" IsVisible="{Binding IsStudio}" />

        <!-- Over everything, bar included: a question about a playlist is not answered by pressing
             Skip underneath it. -->
        <views:DialogHost Grid.RowSpan="4" DataContext="{Binding Dialogs}" />
    </Grid>

</UserControl>
