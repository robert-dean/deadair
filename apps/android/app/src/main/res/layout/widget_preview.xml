<?xml version="1.0" encoding="utf-8"?>
<!--
    What the widget picker shows before one has been placed.

    A layout rather than a screenshot, which is what Android asks for from API 31: it takes the
    phone's own theme and text size, so the preview looks like the thing the listener is about to
    get rather than like the phone it was drawn on. It says the same words a widget with nothing
    playing says, because inventing a record here would be a picture telling a lie.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_preview_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_resting"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/play"
        android:src="@drawable/ic_play"
        android:tint="?android:attr/colorAccent" />
</LinearLayout>
