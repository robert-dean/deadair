<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:conv="using:MaroonedSoftware.Deadair.Desktop.Themes"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.SettingsView"
    x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <!-- One field, whoever declared it. The station's settings and a plugin's arrive in the same
             shape and are drawn the same way; a second copy of this would be a second place for the
             two to drift apart. -->
        <DataTemplate x:Key="SettingField" x:DataType="vm:SettingFieldViewModel">
            <StackPanel Spacing="3" Margin="0,0,0,10">
                <TextBlock Text="{Binding Label}" FontSize="12" Classes="secondary" />

                <CheckBox IsChecked="{Binding Switch}" IsVisible="{Binding IsBoolean}" Content="On" />

                <!-- A minimum as well as a maximum. Left to size itself, an empty box is the width
                     of nothing, which is what an unset setting looks like and is impossible to aim
                     at; stretched, it centres itself in the card and stops lining up with its own
                     label. -->
                <TextBox Text="{Binding Text}" IsVisible="{Binding IsText}"
                         AcceptsReturn="{Binding IsMultiline}"
                         MinHeight="{Binding IsMultiline, Converter={x:Static conv:BoolToLines.Instance}}"
                         MinWidth="320" MaxWidth="480" HorizontalAlignment="Left" />

                <!-- A secret is reported as a configured-boolean and never as a value, so an empty
                     box means leave it alone rather than clear it. -->
                <TextBlock Text="{Binding SecretState}" Classes="dimmed" FontSize="11"
                           IsVisible="{Binding IsSecret}" />

                <TextBlock Text="{Binding Help}" Classes="dimmed" FontSize="11" TextWrapping="Wrap"
                           MaxWidth="560" HorizontalAlignment="Left"
                           IsVisible="{Binding Help, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="{DynamicResource DaPageGutter}" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,14">
            <TextBlock Classes="h1" Text="Settings" />
            <TextBlock Classes="dimmed" Text="{Binding Notice}"
                       IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <!-- Outside the scroll, because it is the station's button and a page long enough to scroll
             is a page where it would otherwise be somewhere below the fold. Appearance and format
             need no Save at all: they are this install's own and are kept the moment they change. -->
        <Button DockPanel.Dock="Bottom" Classes="primary" Content="Save changes"
                HorizontalAlignment="Left" Margin="0,16,0,0"
                Command="{Binding SaveCommand}" IsEnabled="{Binding !Busy}" />

        <ScrollViewer>
            <StackPanel Spacing="22">

                <!-- This install's own, and never sent anywhere: which is why it sits above the
                     station's settings rather than among them, and why neither of these has a Save. -->
                <Border Classes="card" MaxWidth="900" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="18">
                        <TextBlock Classes="h3" Text="This app" />

                        <StackPanel Spacing="6">
                            <TextBlock Classes="dimmed" Text="Appearance" />
                            <Border CornerRadius="{DynamicResource DaCorner}" Padding="3"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource DaRaisedBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton Classes="segment" GroupName="appearance"
                                                 IsChecked="{Binding Appearance, Converter={x:Static conv:AppearanceConverter.System}}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Width="14" Height="14" Data="{DynamicResource DaIconLaptop}" />
                                            <TextBlock Text="System" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Classes="segment" GroupName="appearance"
                                                 IsChecked="{Binding Appearance, Converter={x:Static conv:AppearanceConverter.Light}}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Width="14" Height="14" Data="{DynamicResource DaIconSun}" />
                                            <TextBlock Text="Light" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Classes="segment" GroupName="appearance"
                                                 IsChecked="{Binding Appearance, Converter={x:Static conv:AppearanceConverter.Dark}}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Width="14" Height="14" Data="{DynamicResource DaIconMoon}" />
                                            <TextBlock Text="Dark" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="dimmed" TextWrapping="Wrap"
                                       Text="Follows macOS unless you choose one." />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="dimmed" Text="System Next control" />
                            <CheckBox IsChecked="{Binding NextSkips}" Content="Let the Next key or Control Centre skip the record" />
                            <TextBlock Classes="dimmed" TextWrapping="Wrap"
                                       Text="Only offered while you are signed in as the operator. It skips the record for every listener, so it stays off until you turn it on here." />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="dimmed" Text="Listen in" />
                            <!-- What the station PUBLISHES, read off the last reading. A format it
                                 is not publishing is drawn and disabled rather than hidden: a FLAC
                                 row that vanishes tells somebody who wants FLAC nothing, and finding
                                 out by connecting to each mount would put a silent station on air. -->
                            <ItemsControl ItemsSource="{Binding Formats}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FormatChoiceViewModel">
                                        <RadioButton Classes="segment" GroupName="format"
                                                     IsEnabled="{Binding IsAvailable}"
                                                     IsChecked="{Binding IsChosen, Mode=OneWay}"
                                                     Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ChooseFormatCommand}"
                                                     CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Label}" />
                                                <TextBlock Classes="mono dimmed" Text="{Binding Detail}"
                                                           FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="dimmed" TextWrapping="Wrap"
                                       Text="What the station is publishing. Takes effect the next time you press Listen." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- What this install has been given beyond what it shipped with. Above the
                     station's settings for the same reason the appearance is: it is this machine's
                     own, it never leaves it, and it is the half somebody who only listens can
                     change. -->
                <Border Classes="card" MaxWidth="900" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h3" Text="Extensions" />

                        <TextBlock Classes="dimmed" FontSize="11" TextWrapping="Wrap"
                                   IsVisible="{Binding !HasPlugins}"
                                   Text="{x:Static vm:SettingsViewModel.PluginsFolder}" />

                        <ItemsControl ItemsSource="{Binding Plugins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PluginRowViewModel">
                                    <StackPanel Spacing="6" Margin="0,0,0,18">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Classes="dimmed" FontSize="11" Text="{Binding Origin}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Classes="mono dimmed" FontSize="11"
                                                       VerticalAlignment="Center" Text="{Binding Version}" />

                                            <ToggleSwitch Grid.Column="2" IsChecked="{Binding Enabled}"
                                                          OnContent="" OffContent="" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Why it is not working: the plugin's own words, or the
                                             loader's about it, and the only thing anybody has to go
                                             on. -->
                                        <TextBlock TextWrapping="Wrap" FontSize="11" MaxWidth="560"
                                                   HorizontalAlignment="Left"
                                                   IsVisible="{Binding HasProblem}"
                                                   Text="{Binding Problem}"
                                                   Foreground="{DynamicResource DaToneFaultBrush}" />

                                        <ItemsControl ItemsSource="{Binding Fields}"
                                                      ItemTemplate="{StaticResource SettingField}"
                                                      IsVisible="{Binding HasFields}" />

                                        <!-- The last few things it said. "Why can it not see my
                                             speaker" is the whole diagnosis story for a device
                                             plugin, and no status word answers it. -->
                                        <ItemsControl ItemsSource="{Binding Log}" IsVisible="{Binding HasLog}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Classes="mono dimmed" FontSize="10"
                                                               TextWrapping="Wrap" Text="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Orientation="Horizontal" Spacing="10"
                                                    IsVisible="{Binding HasFields}">
                                            <Button Classes="ghost" Content="Save"
                                                    Command="{Binding SaveCommand}" />
                                            <TextBlock Classes="dimmed" FontSize="11" VerticalAlignment="Center"
                                                       Text="{Binding Notice}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Everything below is drawn from what the station declares, so a setting added
                     there appears here with no code. -->
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingGroupViewModel">
                            <Border Classes="card" MaxWidth="900" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="h3" Text="{Binding Name}" />
                                <ItemsControl ItemsSource="{Binding Fields}"
                                              ItemTemplate="{StaticResource SettingField}" />
                            </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</UserControl>
