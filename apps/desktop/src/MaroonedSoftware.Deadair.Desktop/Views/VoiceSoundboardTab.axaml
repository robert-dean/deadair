<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.VoiceSoundboardTab"
    x:DataType="vm:SoundboardViewModel">

    <UserControl.DataTemplates>
        <!-- One sound. The token is drawn exactly as a script has to write it, in mono, because it is
             the only spelling the station's parser will find. -->
        <DataTemplate DataType="vm:PadRowViewModel">
            <Grid ColumnDefinitions="*,56,80" ColumnSpacing="10" Margin="0,4">
                <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Token}" Classes="mono" FontSize="12" Foreground="{DynamicResource DaToneStandbyBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SourcePath}" FontSize="11" Classes="dimmed" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding SourcePath, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock FontSize="11" Classes="dimmed">
                        <Run Text="last hit " />
                        <Run Text="{Binding LastHit}" />
                    </TextBlock>
                    <!-- A box per set is membership. Sets are few, so they wrap under the sound. -->
                    <ItemsControl ItemsSource="{Binding Sets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PadSetChoiceViewModel">
                                <CheckBox IsChecked="{Binding IsOn}" Content="{Binding Key}" FontSize="11" Margin="0,0,12,0"
                                          Command="{Binding $parent[UserControl].((vm:SoundboardViewModel)DataContext).ToggleSetCommand}"
                                          CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel ItemSpacing="2" LineSpacing="2" Margin="0,4,0,0">
                        <Button Classes="ghost" FontSize="11" Padding="8,2" Content="{Binding PlayLabel}"
                                Command="{Binding $parent[UserControl].((vm:SoundboardViewModel)DataContext).PlayCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Save file" ToolTip.Tip="Save the sound's own file on this Mac"
                                Command="{Binding $parent[UserControl].((vm:SoundboardViewModel)DataContext).SaveFileCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Turn down" IsVisible="{Binding IsActive}"
                                ToolTip.Tip="Take it out of use. Kept, so the next scan does not put it back."
                                Command="{Binding $parent[UserControl].((vm:SoundboardViewModel)DataContext).TurnDownCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Put back" IsVisible="{Binding IsRejected}"
                                Command="{Binding $parent[UserControl].((vm:SoundboardViewModel)DataContext).PutBackCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Delete" IsVisible="{Binding CanDelete}"
                                ToolTip.Tip="Delete it, and the file that was written for it"
                                Command="{Binding $parent[UserControl].((vm:SoundboardViewModel)DataContext).DeleteCommand}"
                                CommandParameter="{Binding}" />
                    </WrapPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Length}" FontSize="11" Classes="mono dimmed" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{Binding Loudness}" FontSize="11" Classes="mono dimmed" HorizontalAlignment="Right"
                           ToolTip.Tip="A sound under about half a second produces no loudness reading at all, which is most drops." />
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
            <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Button Classes="primary" Content="Upload a sound" Command="{Binding UploadCommand}" />
                <Button Classes="ghost" Content="Fetch from an address" Command="{Binding FetchCommand}" />
                <Button Classes="ghost" Content="Re-scan the library" Command="{Binding ScanCommand}" />
            </WrapPanel>
            <TextBlock Classes="dimmed" FontSize="12" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                       Text="The sounds a presenter reaches for, and the sets that decide who reaches which. A persona points at a set by name." />
            <TextBlock Classes="dimmed" Text="{Binding Notice}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                       IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,14,16">
                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="eyebrow" Text="Sets" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="ghost" FontSize="12" Padding="10,3" Content="Add a set" Command="{Binding AddSetCommand}" />
                        </Grid>
                        <TextBlock Classes="dimmed" FontSize="11" TextWrapping="Wrap" Text="{x:Static vm:PadSetDialogViewModel.Help}" />
                        <ItemsControl ItemsSource="{Binding Sets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PadSetRowViewModel">
                                    <Grid ColumnDefinitions="*,150" ColumnSpacing="10" Margin="0,3">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Key}" Classes="mono" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Classes="dimmed" TextWrapping="Wrap">
                                                <Run Text="{Binding Sounds}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Reaches}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Rename"
                                                    Command="{Binding $parent[UserControl].((vm:SoundboardViewModel)DataContext).RenameSetCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Delete"
                                                    ToolTip.Tip="Remove the set. Every sound on it stays in the library."
                                                    Command="{Binding $parent[UserControl].((vm:SoundboardViewModel)DataContext).DeleteSetCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="eyebrow" Text="The library" />
                        <TextBlock Classes="dimmed" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"
                                   Text="Nothing on the rack. Upload an mp3 or a wav, or put one in the pad library on disk and re-scan. The name becomes what a script writes, so airhorn.mp3 is [sfx:airhorn], and the board becomes a set a persona can point at." />
                        <ItemsControl ItemsSource="{Binding Active}" />
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding HasTurnedDown}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="eyebrow" Text="Turned down" />
                        <TextBlock Classes="dimmed" FontSize="11" TextWrapping="Wrap"
                                   Text="Kept rather than deleted, because the scan re-reads the library and a removed row would be back on the next pass. Put one back and it is reachable again." />
                        <ItemsControl ItemsSource="{Binding TurnedDown}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</UserControl>
