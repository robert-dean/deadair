<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:conv="using:MaroonedSoftware.Deadair.Desktop.Themes"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.TransportView"
    x:DataType="vm:TransportViewModel">

    <UserControl.Resources>
        <conv:ToneBrushConverter x:Key="ToneBrush" />
    </UserControl.Resources>

    <StackPanel Spacing="12" IsVisible="{Binding IsOperator}">

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h3" Text="The desk" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="dimmed" VerticalAlignment="Center">
                <Run Text="{Binding Queued}" />
                <Run Text="queued" />
            </TextBlock>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="ghost" Command="{Binding SkipCommand}" IsEnabled="{Binding StreamUp}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Width="13" Height="13" Data="{DynamicResource DaIconSkip}" />
                    <TextBlock Text="Skip" />
                </StackPanel>
            </Button>

            <!-- Two presses, and the second is asked for in the tally colour as well as in the word:
                 Stop takes the station off air and there is no undo. -->
            <Button Classes="ghost" Classes.armed="{Binding IsArmed}" Command="{Binding StopCommand}"
                    IsVisible="{Binding OnAir}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Width="13" Height="13" Data="{DynamicResource DaIconStop}" />
                    <TextBlock Text="{Binding StopLabel}" />
                </StackPanel>
            </Button>

            <Button Classes="ghost" Command="{Binding StartCommand}" IsVisible="{Binding !OnAir}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Width="13" Height="13" Data="{DynamicResource DaIconPlay}" />
                    <TextBlock Text="Start" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- The station's own account of why it is quiet, in the station's own words. The client
             chooses a colour and changes nothing else. -->
        <Border IsVisible="{Binding ShowSilence}" Padding="12"
                CornerRadius="{DynamicResource DaCorner}"
                Background="{DynamicResource DaRaisedBrush}"
                BorderBrush="{DynamicResource DaBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{Binding SilenceTone, Converter={StaticResource ToneBrush}}" />
                    <TextBlock Text="{Binding Silence}" TextWrapping="Wrap"
                               Foreground="{DynamicResource DaTextBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Remedy}" TextWrapping="Wrap" FontSize="12"
                           IsVisible="{Binding Remedy, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Foreground="{DynamicResource DaTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" FontSize="12"
                   IsVisible="{Binding NoticeText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="{DynamicResource DaToneFaultBrush}" />

    </StackPanel>

</UserControl>
