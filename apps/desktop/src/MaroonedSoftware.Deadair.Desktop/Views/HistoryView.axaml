<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:controls="using:MaroonedSoftware.Deadair.Desktop.Controls"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.HistoryView"
    x:DataType="vm:HistoryViewModel">

    <DockPanel Margin="{DynamicResource DaPageGutter}" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,14">
            <TextBlock Classes="h1" Text="History" />
            <TextBlock Classes="dimmed" Text="What the station has played, newest first." />
            <TextBlock Classes="dimmed" Text="{Binding Problem}" TextWrapping="Wrap"
                       IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <!-- One list per day, under the day's own heading. Phase 7 gives the rows their artwork. -->
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryDayViewModel">
                        <StackPanel Spacing="6" Margin="0,0,0,16">
                            <TextBlock Classes="eyebrow" Text="{Binding Label}" Margin="8,0,0,0" />
                            <ListBox Classes="rows" ItemsSource="{Binding Rows}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HistoryRowViewModel">
                                        <Grid ColumnDefinitions="48,36,*,220" ColumnSpacing="12">
                                            <TextBlock Classes="mono dimmed" Text="{Binding When}"
                                                       VerticalAlignment="Center" />
                                            <controls:Artwork Grid.Column="1" Size="36"
                                                              Source="{Binding ArtworkUrl}"
                                                              Initial="{Binding Initial}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource DaTextBrush}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Artists}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Classes="secondary" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
