<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:conv="using:MaroonedSoftware.Deadair.Desktop.Themes"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.TransportView"
    x:DataType="vm:TransportViewModel">

    <UserControl.Resources>
        <conv:ToneBrushConverter x:Key="ToneBrush" />
    </UserControl.Resources>

    <StackPanel Spacing="12" IsVisible="{Binding IsOperator}">

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h3" Text="Next in queue" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="dimmed" VerticalAlignment="Center">
                <Run Text="{Binding Queued}" />
                <Run Text="queued" />
            </TextBlock>
        </Grid>

        <!-- No transport buttons here. Skip is beside the play button in the bar, a click away from
             every page; Stop and Start are the console's, because taking the station off air (or
             putting it back) is not something to do one stray click from the running order. -->

        <!-- The station's own account of why it is quiet, in the station's own words. The client
             chooses a colour and changes nothing else. -->
        <Border IsVisible="{Binding ShowSilence}" Padding="12"
                CornerRadius="{DynamicResource DaCorner}"
                Background="{DynamicResource DaRaisedBrush}"
                BorderBrush="{DynamicResource DaBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="6">
                <!-- A grid rather than a horizontal StackPanel: a StackPanel gives its children all
                     the width they ask for, so the sentence never wrapped and ran off the card. The
                     lamp sits on the first line rather than the middle of a long paragraph. -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0"
                             Fill="{Binding SilenceTone, Converter={StaticResource ToneBrush}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Silence}" TextWrapping="Wrap"
                               Foreground="{DynamicResource DaTextBrush}" />
                </Grid>
                <!-- Indented to the sentence above it (the lamp's 8 and the grid's 8), not to the lamp. -->
                <TextBlock Text="{Binding Remedy}" TextWrapping="Wrap" FontSize="12" Margin="16,0,0,0"
                           IsVisible="{Binding Remedy, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Foreground="{DynamicResource DaTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" FontSize="12"
                   IsVisible="{Binding NoticeText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="{DynamicResource DaToneFaultBrush}" />

    </StackPanel>

</UserControl>
