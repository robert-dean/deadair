<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.PersonaStoriesView"
    x:DataType="vm:PersonaStoriesViewModel">

    <UserControl.DataTemplates>
        <!-- A part or a detail. A proposal is kept or rejected; one in use can only go. -->
        <DataTemplate DataType="vm:StoryPieceViewModel">
            <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="8" Margin="0,1">
                <TextBlock Text="{Binding Ordinal}" Classes="mono dimmed" FontSize="11" HorizontalAlignment="Right" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" MaxWidth="440" />
                    <TextBlock Text="next" FontSize="11" Foreground="{DynamicResource DaToneOkBrush}" IsVisible="{Binding IsNext}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <Button Classes="ghost" FontSize="11" Padding="6,1" Content="Keep" IsVisible="{Binding IsProposed}"
                            Command="{Binding $parent[UserControl].((vm:PersonaStoriesViewModel)DataContext).KeepPieceCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="ghost" FontSize="11" Padding="6,1" Content="Reject" IsVisible="{Binding IsProposed}"
                            Command="{Binding $parent[UserControl].((vm:PersonaStoriesViewModel)DataContext).RejectPieceCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="ghost" FontSize="11" Padding="6,1" Content="Delete" IsVisible="{Binding !IsProposed}"
                            Command="{Binding $parent[UserControl].((vm:PersonaStoriesViewModel)DataContext).DeletePieceCommand}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:PersonaStoryRowViewModel">
            <Border Classes="card" Padding="10" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Told}" FontSize="11" Classes="dimmed" VerticalAlignment="Center" />
                            <TextBlock Text="the station's" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DaToneStandbyBrush}" IsVisible="{Binding ByStation}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Edit" IsVisible="{Binding CanEdit}"
                                    Command="{Binding EditCommand}" />
                            <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Save" IsVisible="{Binding Editing}"
                                    Command="{Binding $parent[UserControl].((vm:PersonaStoriesViewModel)DataContext).SaveEditCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Stop editing" IsVisible="{Binding Editing}"
                                    Command="{Binding StopEditingCommand}" />
                            <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Accept" IsVisible="{Binding IsProposed}"
                                    Command="{Binding $parent[UserControl].((vm:PersonaStoriesViewModel)DataContext).AcceptCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Reject" IsVisible="{Binding IsProposed}"
                                    Command="{Binding $parent[UserControl].((vm:PersonaStoriesViewModel)DataContext).RejectCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Delete" IsVisible="{Binding IsActive}"
                                    Command="{Binding $parent[UserControl].((vm:PersonaStoriesViewModel)DataContext).DeleteCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Classes="ghost" FontSize="11" Padding="8,2" Content="Tell it anyway" IsVisible="{Binding IsRejected}"
                                    Command="{Binding $parent[UserControl].((vm:PersonaStoriesViewModel)DataContext).AcceptCommand}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="3" IsVisible="{Binding !Editing}">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" Classes="secondary" />
                    </StackPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding Editing}">
                        <TextBox Text="{Binding DraftTitle}" MaxLength="200" />
                        <TextBox Text="{Binding DraftStory}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxLength="4000" />
                        <!-- An anecdote becoming a story in parts is how one ordinarily starts;
                             changing it back leaves its parts where they are. -->
                        <ComboBox ItemsSource="{x:Static vm:PersonaStoriesViewModel.Kinds}" SelectedItem="{Binding DraftKind}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DialOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <TextBlock Text="{Binding Source}" FontSize="11" FontStyle="Italic" Classes="dimmed" TextWrapping="Wrap"
                               IsVisible="{Binding Source, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <!-- In telling order, with the part that goes out next marked. -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsArc}">
                        <ItemsControl ItemsSource="{Binding Beats}" />
                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="1" Text="{Binding NewBeat}" PlaceholderText="what happens next in it" MaxLength="4000" />
                            <Button Grid.Column="2" Classes="ghost" FontSize="11" Padding="8,3" Content="Add part"
                                    Command="{Binding $parent[UserControl].((vm:PersonaStoriesViewModel)DataContext).AddBeatCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Details}" />
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="1" Text="{Binding NewDetail}" PlaceholderText="something else you remember about it" MaxLength="1000" />
                        <Button Grid.Column="2" Classes="ghost" FontSize="11" Padding="8,3" Content="Add detail"
                                Command="{Binding $parent[UserControl].((vm:PersonaStoriesViewModel)DataContext).AddDetailCommand}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer>
        <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Left" Margin="0,0,14,16">
            <TextBlock Classes="dimmed" FontSize="12" TextWrapping="Wrap"
                       Text="Things that have happened to this character, told on air. At most one ever reaches a break." />
            <TextBlock Classes="dimmed" Text="{Binding Notice}" TextWrapping="Wrap"
                       IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <StackPanel Spacing="6" IsVisible="{Binding HasProposed}">
                <TextBlock Classes="eyebrow" Text="Proposed" />
                <ItemsControl ItemsSource="{Binding Proposed}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Classes="eyebrow" Text="Tellable" />
                <ItemsControl ItemsSource="{Binding Tellable}" />
                <TextBlock Classes="dimmed" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"
                           Text="This character has nothing to tell, which is an ordinary state: a story band on the clock passes its slot over rather than inventing a past. Write one, and the station will tell it." />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasTurnedDown}">
                <TextBlock Classes="eyebrow" Text="Turned down" />
                <ItemsControl ItemsSource="{Binding TurnedDown}" />
                <TextBlock Classes="dimmed" FontSize="11" Text="Kept rather than deleted, so the station does not propose them again." />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Classes="eyebrow" Text="A new story" />
                <TextBox Text="{Binding NewTitle}" PlaceholderText="The Barstow lights" MaxLength="200" />
                <TextBlock FontSize="11" Classes="dimmed" TextWrapping="Wrap"
                           Text="What you call it. Never said out loud: it is how this list is read, and how the station names one in a log." />
                <TextBox Text="{Binding NewStory}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxLength="4000"
                         PlaceholderText="You saw three lights over the desert outside Barstow in ninety-seven." />
                <TextBlock FontSize="11" Classes="dimmed" TextWrapping="Wrap"
                           Text="In this character's own voice, and out loud: with no model available the station reads it exactly as you write it." />
                <Button Classes="ghost" Content="Add" HorizontalAlignment="Right" Command="{Binding AddCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
