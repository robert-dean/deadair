        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "jsdom": "^30.0.1",
        "postcss": "^8.5.25",
        "postcss-preset-mantine": "^1.18.0",
        "postcss-simple-vars": "^7.0.1",
        "prettier": "^3.9.6",
        "typescript": "6.0.3",
        "vite": "^8.2.0",
        "vitest": "^4.1.10"
    }
