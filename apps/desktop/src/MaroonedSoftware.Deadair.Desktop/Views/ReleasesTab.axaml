<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.ReleasesTab"
    x:DataType="vm:ReleasesViewModel">

    <UserControl.DataTemplates>
        <!-- One release and its notes, the same card for a newer release and one on this station. -->
        <DataTemplate x:DataType="vm:ReleaseCardViewModel">
            <Border Classes="card" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Classes="h3 mono" Text="{Binding Version}" VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <TextBlock Classes="dimmed" Text="{Binding Date}" VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   IsVisible="{Binding Date, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Border Classes="pill" Height="20" Margin="0,0,12,0"
                                IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding Badge}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DaAccentBrush}" />
                        </Border>
                        <HyperlinkButton Content="Release page" FontSize="12" Padding="0" VerticalAlignment="Center"
                                         NavigateUri="{Binding Page}"
                                         IsVisible="{Binding Page, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </WrapPanel>
                    <!-- The changelog's Markdown with its marks taken off (ReleaseCheck.PlainNotes). -->
                    <SelectableTextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                         IsVisible="{Binding HasNotes}"
                                         Foreground="{DynamicResource DaTextSecondaryBrush}" />
                    <TextBlock Classes="dimmed" Text="Nothing was recorded for this release."
                               IsVisible="{Binding !HasNotes}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,12,8">

            <TextBlock Text="{Binding Problem}" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource DaSeverityFailureBrush}" />

            <StackPanel Spacing="8" IsVisible="{Binding Loaded}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Classes="dimmed" Text="{Binding CheckLine}" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <!-- No button while the check is off: it would send nothing, and pressing it
                         would look like an answer. -->
                    <Button Grid.Column="1" Classes="ghost" Content="Check now" FontSize="12" Padding="10,4"
                            VerticalAlignment="Center" Command="{Binding CheckNowCommand}"
                            IsVisible="{Binding Checks}" />
                </Grid>
                <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" FontSize="13"
                           IsVisible="{Binding Outcome, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Foreground="{DynamicResource DaTextBrush}" />
            </StackPanel>

            <!-- Newer releases first and set apart: they are why somebody following a notice came. -->
            <StackPanel Spacing="10"
                        IsVisible="{Binding AvailableHeading, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="eyebrow" Text="{Binding AvailableHeading}" />
                <TextBlock Text="Upgrading is pulling the new image, the same way the station was installed. It keeps everything it holds across the upgrade."
                           TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource DaTextBrush}" />
                <ItemsControl ItemsSource="{Binding Available}" />
                <TextBlock Classes="eyebrow" Text="ON THIS STATION" />
            </StackPanel>

            <TextBlock Classes="dimmed" Text="{Binding Empty}" TextWrapping="Wrap"
                       IsVisible="{Binding Empty, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <ItemsControl ItemsSource="{Binding Notes}" />

            <Button Classes="ghost" Content="{Binding ShowOlderLabel}" HorizontalAlignment="Left"
                    Command="{Binding ShowOlderCommand}" IsVisible="{Binding HasOlder}" />

        </StackPanel>
    </ScrollViewer>

</UserControl>
