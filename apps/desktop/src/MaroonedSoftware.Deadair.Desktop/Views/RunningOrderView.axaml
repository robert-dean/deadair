<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:conv="using:MaroonedSoftware.Deadair.Desktop.Themes"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.RunningOrderView"
    x:DataType="vm:RunningOrderViewModel">

    <UserControl.Resources>
        <conv:ToneBrushConverter x:Key="ToneBrush" />
    </UserControl.Resources>

    <DockPanel IsVisible="{Binding IsOperator}" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                       Foreground="{DynamicResource DaTextBrush}" />

            <!-- What the operator asked for, in their own words. It keeps steering every refill, so
                 it is shown rather than only accepted. -->
            <TextBlock Text="{Binding Brief}" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding Brief, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource DaTextSecondaryBrush}" />
            <TextBlock Text="{Binding Host, StringFormat='Hosted by {0}'}" FontSize="12"
                       IsVisible="{Binding Host, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource DaTextDimmedBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Shuffle" Command="{Binding ShuffleCommand}" />
                <Button Content="Extend now" Command="{Binding ExtendCommand}" />
            </StackPanel>

            <!-- Undo is offered only for a record. A segment is marked removed by the station and
                 cannot come back, so offering it would be offering something that cannot happen. -->
            <Button Content="{Binding UndoLabel}" Command="{Binding UndoDropCommand}"
                    IsVisible="{Binding CanUndo}" HorizontalAlignment="Left" />

            <TextBlock Text="{Binding RunsDryLabel}" FontSize="12"
                       Foreground="{Binding IsShort, Converter={x:Static conv:ShortOrderBrushConverter.Instance}}" />
        </StackPanel>

        <!-- A virtualising list rather than a grid: Avalonia 12 deprecates DataGrid, and an order can
             run to hundreds of rows. -->
        <ListBox ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:OrderItemViewModel">
                    <!-- Fixed widths on the last two columns. Every row is its own Grid, so an
                         `Auto` column sizes to that row alone: a row whose move buttons are hidden
                         gave its duration a different x from the row above, and the times marched
                         about down the list. -->
                    <Grid ColumnDefinitions="Auto,*,52,108" ColumnSpacing="10" Margin="0,3">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{Binding Tone, Converter={StaticResource ToneBrush}}" />

                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DaTextBrush}" />
                            <TextBlock Text="{Binding Artists}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding !IsSegment}"
                                       Foreground="{DynamicResource DaTextDimmedBrush}" />
                            <TextBlock Text="{Binding Label}" FontSize="11"
                                       IsVisible="{Binding IsSegment}"
                                       Foreground="{DynamicResource DaTextDimmedBrush}" />
                        </StackPanel>

                        <TextBlock Classes="mono" Grid.Column="2" Text="{Binding Length}" FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource DaTextDimmedBrush}" />

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                    HorizontalAlignment="Right" IsVisible="{Binding CanMove}">
                            <Button Content="↑" FontSize="11" Padding="6,2"
                                    Command="{Binding $parent[ListBox].((vm:RunningOrderViewModel)DataContext).MoveUpCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Content="↓" FontSize="11" Padding="6,2"
                                    Command="{Binding $parent[ListBox].((vm:RunningOrderViewModel)DataContext).MoveDownCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Content="✕" FontSize="11" Padding="6,2"
                                    Command="{Binding $parent[ListBox].((vm:RunningOrderViewModel)DataContext).DropCommand}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>

</UserControl>
