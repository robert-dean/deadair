<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.RenameStationPlaylistDialogView"
    x:DataType="vm:RenameStationPlaylistDialogViewModel">

    <StackPanel Spacing="12" Width="420">
        <StackPanel Spacing="4">
            <TextBlock Text="Name" FontSize="12" Classes="secondary" />
            <TextBox Text="{Binding Name}" MaxLength="200" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="What it is for" FontSize="12" Classes="secondary" />
            <TextBox Text="{Binding Prompt}" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="64" />
            <TextBlock Text="In your own words. Optional." FontSize="11" Classes="dimmed" />
        </StackPanel>
    </StackPanel>

</UserControl>
