# Sourced, not run.
#
# The keys `init-secrets` made, for whichever of them the operator did not set. Only the values
# nobody set are filled in, as `database-env` does, so a variable always beats the file.
DATA="${DATA_DIR:-/data}"

if [ -z "${KMS_LOCAL_ROOT_KEY:-}" ] && [ -s "$DATA/secrets/KMS_LOCAL_ROOT_KEY" ]; then
    KMS_LOCAL_ROOT_KEY="$(cat "$DATA/secrets/KMS_LOCAL_ROOT_KEY")"
    export KMS_LOCAL_ROOT_KEY
fi
if [ -z "${AUTHENTICATION_SESSION_JWT_PRIVATE_KEY:-}" ] && [ -s "$DATA/secrets/AUTHENTICATION_SESSION_JWT_PRIVATE_KEY" ]; then
    AUTHENTICATION_SESSION_JWT_PRIVATE_KEY="$(cat "$DATA/secrets/AUTHENTICATION_SESSION_JWT_PRIVATE_KEY")"
    export AUTHENTICATION_SESSION_JWT_PRIVATE_KEY
fi
