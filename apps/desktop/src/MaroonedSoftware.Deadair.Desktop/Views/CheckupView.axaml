<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:conv="using:MaroonedSoftware.Deadair.Desktop.Themes"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.CheckupView"
    x:DataType="vm:CheckupViewModel">

    <DockPanel Margin="{DynamicResource DaPageGutter}" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,14">
            <TextBlock Classes="h1" Text="Check-up" />
            <StackPanel Orientation="Horizontal" Spacing="14">
                <!-- Stamped, so a page left open overnight cannot pass itself off as now. -->
                <TextBlock Classes="eyebrow" Text="{Binding ReadAt}" />
                <TextBlock Classes="eyebrow" Text="{Binding Revision}" />
            </StackPanel>
        </StackPanel>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="20">

            <StackPanel Spacing="16">

                <StackPanel Spacing="8">
                    <TextBlock Classes="h3" Text="Needs you" />
                    <TextBlock Classes="dimmed" Text="Nothing needs you." IsVisible="{Binding NothingNeedsYou}" />
                    <ItemsControl ItemsSource="{Binding Attention}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AttentionViewModel">
                                <!-- A card with a spine rather than a dot, which is the web
                                     console's Alert: a page of these is read by severity first, and
                                     a 2px edge carries that further down a column than a 7px dot. -->
                                <Border Classes="card" Padding="0" Margin="0,0,0,8" ClipToBounds="True">
                                    <Grid ColumnDefinitions="2,*">
                                        <Rectangle Fill="{Binding Severity, Converter={x:Static conv:SeverityBrushConverter.Instance}}" />
                                        <StackPanel Grid.Column="1" Spacing="3" Margin="14,10">
                                            <!-- The station writes both lines; this draws them. -->
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource DaTextBrush}" />
                                            <TextBlock Text="{Binding Detail}" Classes="dimmed" FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="h3" Text="Machinery" />
                        <!-- Two timestamps and no verdict: a five-second reconcile and a nightly
                             sweep are both healthy, and no single threshold describes both. -->
                        <ItemsControl ItemsSource="{Binding Loops}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LoopViewModel">
                                    <Grid ColumnDefinitions="*,150" Margin="0,3">
                                        <TextBlock Classes="mono secondary" Text="{Binding Name}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding LastBeat}" Classes="dimmed"
                                                   FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Backlog}" Classes="dimmed" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>

            <DockPanel Grid.Column="1" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Classes="h3" Text="Activity" Margin="0,0,0,8" />
                <ListBox Classes="rows" ItemsSource="{Binding Activity}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActivityViewModel">
                            <Grid ColumnDefinitions="8,64,90,*" ColumnSpacing="8">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{Binding Severity, Converter={x:Static conv:SeverityBrushConverter.Instance}}" />
                                <TextBlock Classes="mono" Grid.Column="1" Text="{Binding When}" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource DaTextDimmedBrush}" />
                                <TextBlock Classes="mono" Grid.Column="2" Text="{Binding Module}" FontSize="11"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource DaTextDimmedBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource DaTextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

        </Grid>

    </DockPanel>

</UserControl>
