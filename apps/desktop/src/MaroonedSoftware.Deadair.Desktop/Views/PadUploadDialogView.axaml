<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.PadUploadDialogView"
    x:DataType="vm:PadUploadDialogViewModel">

    <StackPanel Spacing="10" Width="440">
        <TextBlock Text="{Binding FileName}" Classes="mono" FontSize="11" TextTrimming="CharacterEllipsis" />
        <StackPanel Spacing="3">
            <TextBlock Text="Board" FontSize="12" Classes="secondary" />
            <AutoCompleteBox Text="{Binding Board}" ItemsSource="{Binding Boards}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" />
            <TextBlock Text="The folder it is filed under, which is also the set it joins. A new name makes both." FontSize="11" Classes="dimmed" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="3">
            <TextBlock Text="Name" FontSize="12" Classes="secondary" />
            <TextBox Text="{Binding Name}" />
            <TextBlock FontSize="11" Classes="dimmed">
                <Run Text="What a script will write: " />
                <Run Text="{Binding Token}" FontFamily="{DynamicResource DaFontMono}" />
            </TextBlock>
        </StackPanel>
        <StackPanel Spacing="3">
            <TextBlock Text="Label" FontSize="12" Classes="secondary" />
            <TextBox Text="{Binding Label}" />
        </StackPanel>
    </StackPanel>

</UserControl>
