<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:views="using:MaroonedSoftware.Deadair.Desktop.Views"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.CheckupView"
    x:DataType="vm:CheckupViewModel">

    <DockPanel Margin="{DynamicResource DaPageGutter}" LastChildFill="True">

        <!-- Name only: each tab opens with its own reading, and the rail says what the section is. -->
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,14">
            <TextBlock Classes="h1" Text="Check-up" />

            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="tab" Classes.active="{Binding IsMachinery}" Content="Machinery"
                        Command="{Binding ShowTabCommand}" CommandParameter="Machinery" />
                <Button Classes="tab" Classes.active="{Binding IsHistory}" Content="History"
                        Command="{Binding ShowTabCommand}" CommandParameter="History" />
                <Button Classes="tab" Classes.active="{Binding IsCost}" Content="Cost"
                        Command="{Binding ShowTabCommand}" CommandParameter="Cost" />
                <Button Classes="tab" Classes.active="{Binding IsLogs}" Content="Logs"
                        Command="{Binding ShowTabCommand}" CommandParameter="Logs" />
                <Button Classes="tab" Classes.active="{Binding IsReleases}" Content="What's new"
                        Command="{Binding ShowTabCommand}" CommandParameter="Releases" />
            </StackPanel>
        </StackPanel>

        <Panel>
            <views:MachineryTab DataContext="{Binding Machinery}"
                                IsVisible="{Binding $parent[UserControl].((vm:CheckupViewModel)DataContext).IsMachinery}" />
            <views:ActivityFeedTab DataContext="{Binding History}"
                                   IsVisible="{Binding $parent[UserControl].((vm:CheckupViewModel)DataContext).IsHistory}" />
            <views:CostTab DataContext="{Binding Cost}"
                           IsVisible="{Binding $parent[UserControl].((vm:CheckupViewModel)DataContext).IsCost}" />
            <views:LogsTab DataContext="{Binding Logs}"
                           IsVisible="{Binding $parent[UserControl].((vm:CheckupViewModel)DataContext).IsLogs}" />
            <views:ReleasesTab DataContext="{Binding Releases}"
                               IsVisible="{Binding $parent[UserControl].((vm:CheckupViewModel)DataContext).IsReleases}" />
        </Panel>

    </DockPanel>

</UserControl>
