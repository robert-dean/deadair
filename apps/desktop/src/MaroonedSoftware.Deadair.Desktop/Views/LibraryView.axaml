<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:views="using:MaroonedSoftware.Deadair.Desktop.Views"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.LibraryView"
    x:DataType="vm:LibraryViewModel">

    <DockPanel Margin="{DynamicResource DaPageGutter}" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,14">
            <TextBlock Classes="h1" Text="Library" />

            <!-- The same tab strip Voice has, which is the whole reason it is a class: this page had
                 six identical buttons and nothing said which one you were on. -->
            <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Button Classes="tab" Classes.active="{Binding IsTracks}" Content="Records"
                        Command="{Binding ShowTabCommand}" CommandParameter="Tracks" />
                <Button Classes="tab" Classes.active="{Binding IsArtists}" Content="Acts"
                        Command="{Binding ShowTabCommand}" CommandParameter="Artists" />
                <Button Classes="tab" Classes.active="{Binding IsAlbums}" Content="Releases"
                        Command="{Binding ShowTabCommand}" CommandParameter="Albums" />
                <Button Classes="tab" Classes.active="{Binding IsPlaylists}" Content="Playlists"
                        Command="{Binding ShowTabCommand}" CommandParameter="Playlists" />
                <Button Classes="tab" Classes.active="{Binding IsCharts}" Content="Charts"
                        Command="{Binding ShowTabCommand}" CommandParameter="Charts" />
                <Button Classes="tab" Classes.active="{Binding IsNews}" Content="News"
                        Command="{Binding ShowTabCommand}" CommandParameter="News" />
                <Button Classes="tab" Classes.active="{Binding IsPodcasts}" Content="Podcasts"
                        Command="{Binding ShowTabCommand}" CommandParameter="Podcasts" />
            </WrapPanel>
        </StackPanel>

        <!-- One view per tab, each over its own view model. The visibility is on a Panel around the
             tab rather than on the tab itself, because setting DataContext on an element re-scopes
             every binding on it, IsVisible included. -->
        <Panel>
            <Panel IsVisible="{Binding IsTracks}">
                <views:RecordsTab DataContext="{Binding Records}" />
            </Panel>
            <Panel IsVisible="{Binding IsArtists}">
                <views:ActsTab DataContext="{Binding Acts}" />
            </Panel>
            <Panel IsVisible="{Binding IsAlbums}">
                <views:AlbumsTab DataContext="{Binding Releases}" />
            </Panel>
            <Panel IsVisible="{Binding IsPlaylists}">
                <views:PlaylistsTab DataContext="{Binding Playlists}" />
            </Panel>
            <Panel IsVisible="{Binding IsCharts}">
                <views:ChartsTab DataContext="{Binding Charts}" />
            </Panel>
            <Panel IsVisible="{Binding IsNews}">
                <views:NewsTab DataContext="{Binding News}" />
            </Panel>
            <Panel IsVisible="{Binding IsPodcasts}">
                <views:PodcastsTab DataContext="{Binding Podcasts}" />
            </Panel>
        </Panel>

    </DockPanel>

</UserControl>
