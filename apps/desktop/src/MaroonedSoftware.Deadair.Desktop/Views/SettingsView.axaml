<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:views="using:MaroonedSoftware.Deadair.Desktop.Views"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.SettingsView"
    x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <!-- One entry in the list of sections. A dot beside a section holding an unsaved edit, so
             moving to another one does not mean forgetting it. -->
        <DataTemplate x:Key="SectionEntry" x:DataType="vm:SettingsSectionViewModel">
            <Button Classes="nav" Classes.active="{Binding IsActive}" Height="32"
                    ToolTip.Tip="{Binding Hint}"
                    Command="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).ShowSectionCommand}"
                    CommandParameter="{Binding}">
                <Grid ColumnDefinitions="*,10">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Ellipse Grid.Column="1" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                             Fill="{DynamicResource DaAccentBrush}" IsVisible="{Binding IsDirty}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ComboBox.sectionPicker">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- The list takes 200 units, which the page can spare only when it is wide. Narrower (the
             default window with Now playing open, or the minimum window) the list becomes one box
             above the section, so the section keeps the room a form needs. -->
        <ContainerQuery Name="SettingsPage" Query="max-width:760">
            <Style Selector="ScrollViewer.sectionList">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="ComboBox.sectionPicker">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <DockPanel Margin="{DynamicResource DaPageGutter}" LastChildFill="True">

        <TextBlock DockPanel.Dock="Top" Classes="h1" Text="Settings" Margin="0,0,0,14" />

        <DockPanel Container.Name="SettingsPage" Container.Sizing="Width" LastChildFill="True">

            <!-- The sections are a list inside the page rather than a strip of tabs: nineteen tabs do
                 not fit a window, and a strip has nowhere to say which half of the list is whose. -->
            <ScrollViewer Classes="sectionList" DockPanel.Dock="Left" Width="176" Margin="0,0,22,0">
                <StackPanel Spacing="2">
                    <ContentControl Content="{Binding AppSection}" ContentTemplate="{StaticResource SectionEntry}" />

                    <!-- The station's own, listed only for its operator. -->
                    <TextBlock Classes="eyebrow" Text="THE STATION" Margin="12,14,0,6" IsVisible="{Binding IsOperator}" />
                    <ItemsControl ItemsSource="{Binding StationSections}" ItemTemplate="{StaticResource SectionEntry}" />
                </StackPanel>
            </ScrollViewer>

            <ComboBox Classes="sectionPicker" DockPanel.Dock="Top" Width="260" Margin="0,0,0,16"
                      ItemsSource="{Binding Sections}" SelectedItem="{Binding Picked}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsSectionViewModel">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ContentControl Content="{Binding Current.Content}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:SettingsViewModel">
                        <views:SettingsAppSection />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SettingsGroupViewModel">
                        <views:SettingsGroupSection />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ArtworkSectionViewModel">
                        <views:SettingsArtworkSection />
                    </DataTemplate>
                    <DataTemplate DataType="vm:StorageSectionViewModel">
                        <views:SettingsStorageSection />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ProvidersSectionViewModel">
                        <views:SettingsProvidersSection />
                    </DataTemplate>
                    <DataTemplate DataType="vm:GrantsSectionViewModel">
                        <views:SettingsGrantsSection />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </DockPanel>

    </DockPanel>

</UserControl>
