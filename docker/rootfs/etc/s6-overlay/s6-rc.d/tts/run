#!/bin/sh
# The station's voice.
exec 2>&1

# Off when the operator already runs a speech server of their own and has pointed the speech plugin
# at it: a second copy of the model idling on the CPU here is memory the station never uses. This is
# for the `full` tag above all, which is the only way to get the bundled database and cache and so
# cannot be swapped for `slim` just to lose the voice.
#
# Asleep rather than exited, because a service that exits is a service the supervisor restarts.
case "$(echo "${BUNDLED_TTS:-on}" | tr '[:upper:]' '[:lower:]')" in
    off | false | 0 | no)
        echo "tts: BUNDLED_TTS is off, so the bundled speech server is not started; the station speaks through whatever its speech plugin points at"
        exec sleep infinity
        ;;
esac

cd /opt/tts || exit 1

# Its own interpreter and its own environment, kept apart from the measurement sidecar's: they
# want different Pythons and neither should be able to break the other by being upgraded.
#
# Invoked as `python -m` rather than through the environment's own `uvicorn` script, because that
# script's first line names the path this tree had in the image it came from, and it is not that
# path here.
PYTHONPATH=/opt/tts:/opt/tts/api
export PYTHONPATH

# Where its weights and its voices are. The defaults are ABSOLUTE and name the path this tree had
# in the image it came from — `/app`, which here is the station's own workspace, owned by root and
# holding something else entirely. So the server came up, tried to make a directory inside it, was
# refused, and took the whole container down with it.
#
# Set here rather than in the image's environment because every variable this container is started
# with is a layer of the station's configuration now: these are one service's settings and have no
# business being visible as the station's.
MODEL_DIR=/opt/tts/api/src/models
VOICES_DIR=/opt/tts/api/src/voices/v1_0
export MODEL_DIR VOICES_DIR

# Loopback: the voice is the station's, not something the network is offered.
exec s6-setuidgid deadair /opt/tts/.venv/bin/python -m uvicorn api.src.main:app \
    --host 127.0.0.1 --port "${TTS_PORT:-8880}"
