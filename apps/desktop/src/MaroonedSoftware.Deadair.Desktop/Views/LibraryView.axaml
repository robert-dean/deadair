<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.LibraryView"
    x:DataType="vm:LibraryViewModel">

    <DockPanel Margin="24" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,14">
            <TextBlock Text="Library" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource DaTextBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Records" Command="{Binding ShowTabCommand}" CommandParameter="Tracks" />
                <Button Content="Acts" Command="{Binding ShowTabCommand}" CommandParameter="Artists" />
                <Button Content="Releases" Command="{Binding ShowTabCommand}" CommandParameter="Albums" />
                <Button Content="Playlists" Command="{Binding ShowTabCommand}" CommandParameter="Playlists" />
                <Button Content="Charts" Command="{Binding ShowTabCommand}" CommandParameter="Charts" />
                <Button Content="News" Command="{Binding ShowTabCommand}" CommandParameter="News" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsTracks}">
                <TextBox Text="{Binding Search}" PlaceholderText="Search records" IsEnabled="{Binding !Busy}" />
                <Button Grid.Column="1" Content="Search" Command="{Binding SearchTracksCommand}" />
            </Grid>

            <TextBlock Text="{Binding Notice}" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource DaTextDimmedBrush}" />
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,12,0,0"
              IsVisible="{Binding ShowsPaging}">
            <Button Content="Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoBack}" />
            <TextBlock Grid.Column="1" Text="{Binding Summary}" VerticalAlignment="Center"
                       HorizontalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource DaTextDimmedBrush}" />
            <Button Grid.Column="2" Content="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoForward}" />
        </Grid>

        <Panel>

            <ListBox ItemsSource="{Binding Tracks}" IsVisible="{Binding IsTracks}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrackRowViewModel">
                        <Grid ColumnDefinitions="*,180,60,50" ColumnSpacing="12" Margin="0,3">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DaTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Artists}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DaTextSecondaryBrush}" />
                            <TextBlock Classes="mono" Grid.Column="2" Text="{Binding Year}" FontSize="11"
                                       Foreground="{DynamicResource DaTextDimmedBrush}" />
                            <TextBlock Classes="mono" Grid.Column="3" Text="{Binding Length}" FontSize="11"
                                       Foreground="{DynamicResource DaTextDimmedBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox ItemsSource="{Binding Artists}" IsVisible="{Binding IsArtists}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArtistRowViewModel">
                        <TextBlock Text="{Binding Name}" Margin="0,3" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource DaTextBrush}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox ItemsSource="{Binding Albums}" IsVisible="{Binding IsAlbums}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlbumRowViewModel">
                        <Grid ColumnDefinitions="*,220" ColumnSpacing="12" Margin="0,3">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DaTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ArtistName}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DaTextSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Putting the station on air from one of these REPLACES the running order. -->
            <ListBox ItemsSource="{Binding Playlists}" IsVisible="{Binding IsPlaylists}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaylistRowViewModel">
                        <Grid ColumnDefinitions="*,120,Auto" ColumnSpacing="12" Margin="0,3">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DaTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Source}" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource DaTextDimmedBrush}" />
                            <Button Grid.Column="2" Content="Put on air" FontSize="11" Padding="8,3"
                                    Command="{Binding $parent[ListBox].((vm:LibraryViewModel)DataContext).PlayPlaylistCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox ItemsSource="{Binding Charts}" IsVisible="{Binding IsCharts}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChartRowViewModel">
                        <Grid ColumnDefinitions="*,120,Auto" ColumnSpacing="12" Margin="0,3">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DaTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Source}" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource DaTextDimmedBrush}" />
                            <Button Grid.Column="2" Content="Put on air" FontSize="11" Padding="8,3"
                                    Command="{Binding $parent[ListBox].((vm:LibraryViewModel)DataContext).PlayChartCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox ItemsSource="{Binding Stories}" IsVisible="{Binding IsNews}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:StoryRowViewModel">
                        <StackPanel Spacing="2" Margin="0,4">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource DaTextBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding Feed}" FontSize="11"
                                           Foreground="{DynamicResource DaTextDimmedBrush}" />
                                <TextBlock Text="{Binding When}" FontSize="11"
                                           Foreground="{DynamicResource DaTextDimmedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Panel>

    </DockPanel>

</UserControl>
