{
    "camelCase": true,
    "customImports": {
        "DateTime": "luxon",
        "Duration": "luxon"
    },
    "dateParser": "timestamp",
    "defaultSchemas": [
        "public"
    ],
    "dialect": "postgres",
    "domains": true,
    "envFile": ".env",
    "excludePattern": "pgboss.*",
    "includePattern": null,
    "logLevel": "warn",
    "numericParser": "string",
    "outFile": "./src/modules/data/db.ts",
    "overrides": {
        "columns": {
            "deadair.actors.type": "'user' | 'system' | 'vendor'",
            "deadair.actors_authenticator_factors.type": "'totp' | 'hotp'",
            "deadair.actors_authenticator_factors.algorithm": "'sha1' | 'sha256' | 'sha512'",
            "deadair.actor_session_events.event_type": "'created' | 'refreshed' | 'revoked' | 'expired' | 'step_up' | 'validation_failed'",
            "deadair.plugin_configs.log_level": "Generated<'debug' | 'info' | 'warn' | 'error'>",
            "deadair.plugin_grants.decision": "'allowed' | 'denied'",
            "deadair.track_sources.origin": "Generated<'sync' | 'discovered'>",
            "deadair.track_sources.advisory": "'explicit' | 'clean' | null",
            "deadair.station_lineup.mode": "Generated<'rotation' | 'setlist' | 'feature'>",
            "deadair.station_lineup.on_end": "Generated<'extend' | 'repeat' | 'stop'>",
            "deadair.segments.state": "Generated<'planned' | 'writing' | 'written' | 'rendering' | 'ready' | 'failed'>",
            "deadair.segment_events.to_state": "'planned' | 'writing' | 'written' | 'rendering' | 'ready' | 'failed'",
            "deadair.script_history.outcome": "'written' | 'declined' | 'failed'",
            "deadair.station_events.module": "'playout' | 'director' | 'render' | 'catalog' | 'plugins'",
            "deadair.station_events.severity": "Generated<'info' | 'warn' | 'fault'>",
            "deadair.personas.kind": "Generated<'host' | 'caller'>",
            "deadair.break_requests.urgency": "'interrupt' | 'next' | 'soon' | 'whenever'",
            "deadair.break_requests.state": "Generated<'pending' | 'ready' | 'placed' | 'expired' | 'failed'>",
            "deadair.facts.category": "Generated<'summary' | 'placement' | 'chart' | 'recording' | 'personnel' | 'controversy' | 'cover_or_sample' | 'ending'>",
            "deadair.facts.source": "'lead' | 'model'",
            "deadair.fact_extractions.source": "'lead' | 'model' | 'gloss'",
            "deadair.productions.writing_mode": "Generated<'quick' | 'outlined' | 'polished'>",
            "deadair.productions.state": "Generated<'planned' | 'outlining' | 'drafting' | 'checking' | 'rendering' | 'stitching' | 'ready' | 'aired' | 'failed' | 'cancelled'>",
            "deadair.schedule_slots.source_chart_order": "'countdown' | 'ranked' | 'unordered' | null",
            "deadair.schedule_slots.mode": "Generated<'rotation' | 'setlist' | 'feature'>",
            "deadair.schedule_slots.on_end": "Generated<'extend' | 'repeat' | 'stop'>",
            "deadair.clock_bands.at": "'clock' | 'interval'",
            "deadair.pronunciations.state": "'active' | 'suggested' | 'rejected'",
            "deadair.pronunciations.origin": "'operator' | 'gloss'",
            "deadair.pronunciations.subject_kind": "'track' | 'album' | 'artist' | null",
            "deadair.persona_notes.kind": "'said' | 'trait'",
            "deadair.persona_notes.state": "'active' | 'suggested' | 'rejected'",
            "deadair.persona_notes.origin": "'operator' | 'model'",
            "deadair.persona_stories.state": "'active' | 'suggested' | 'rejected'",
            "deadair.persona_stories.origin": "'operator' | 'model'",
            "deadair.persona_story_details.state": "'active' | 'suggested' | 'rejected'",
            "deadair.persona_story_details.origin": "'operator' | 'model'",
            "deadair.pads.state": "Generated<'active' | 'rejected'>"
        }
    },
    "partitions": false,
    "print": false,
    "runtimeEnums": false,
    "singularize": false,
    "typeMapping": {
        "date": "DateTime",
        "timestamptz": "DateTime",
        "interval": "Duration",
        "int8": "bigint"
    },
    "typeOnlyImports": true,
    "url": "env(DATABASE_URL)",
    "verify": false
}
