<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:conv="using:MaroonedSoftware.Deadair.Desktop.Themes"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.ProgrammeView"
    x:DataType="vm:ProgrammeViewModel">

    <DockPanel Margin="{DynamicResource DaPageGutter}" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14">
            <TextBlock Classes="h1" Text="Programme" />

            <Border Classes="card" MaxWidth="620" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="ON NOW" />
                    <TextBlock Text="{Binding OnNow}" TextWrapping="Wrap"
                               Foreground="{DynamicResource DaTextBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Classes="dimmed" Text="{Binding Problem}" TextWrapping="Wrap"
                       IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <!-- Read-only. Editing a timetable wants dragging, and a wrong drop reschedules a broadcast. -->
        <!-- A timetable rather than a table: the rule down the middle is what makes a list of times
             read as a day, and the dot on it is where the station actually is. -->
        <ListBox Classes="rows" ItemsSource="{Binding Slots}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SlotViewModel">
                    <Grid ColumnDefinitions="110,20,*" ColumnSpacing="12">
                        <TextBlock Classes="mono" Grid.Column="0" Text="{Binding Window}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DaTextSecondaryBrush}" />

                        <Panel Grid.Column="1">
                            <!-- Negative by exactly the row's own vertical padding, so the rule
                                 joins up between rows instead of drawing as a column of dashes. -->
                            <Rectangle Width="2" HorizontalAlignment="Center" Margin="0,-6"
                                       Fill="{DynamicResource DaBorderBrush}" />
                            <Ellipse Classes="lamp" Classes.live="{Binding IsAiring}" Width="7" Height="7"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Fill="{Binding IsAiring, Converter={x:Static conv:AiringBrushConverter.Instance}}" />
                        </Panel>

                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource DaTextBrush}" />
                                <!-- The slot actually airing, which is not always the one the clock
                                     says: a hold keeps a broadcast past its slot on purpose. -->
                                <Border Classes="pill" IsVisible="{Binding IsAiring}" Height="20"
                                        Padding="8,0" BorderThickness="0"
                                        Background="{DynamicResource DaToneLiveBrush}">
                                    <TextBlock Classes="eyebrow" Text="ON AIR"
                                               Foreground="{DynamicResource DaBgBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Days}" Classes="dimmed" FontSize="11" />
                            <TextBlock Text="{Binding Brief}" Classes="dimmed" FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding Brief, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>

</UserControl>
