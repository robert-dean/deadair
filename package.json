{
    "name": "deadair",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "turbo run build",
        "build:all": "turbo run codegen && turbo run build",
        "codegen": "turbo run codegen",
        "build:data": "turbo run build:data",
        "rebuild:data": "turbo run rebuild:data && pnpm flush:sessions",
        "build:contracts": "turbo run build:contracts --",
        "build:permissions": "turbo run build:permissions",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "turbo run format",
        "format:check": "prettier --check .",
        "test": "turbo run test",
        "build:datatypes": "turbo run build:datatypes",
        "migrate:create": "turbo run migrate:create --",
        "migrate:up": "turbo run migrate:up",
        "migrate:down": "turbo run migrate:down",
        "migrate:down:all": "turbo run migrate:down:all",
        "db:reset": "docker compose rm -sfv db && docker compose up -d --wait db && turbo run migrate:up && pnpm flush:sessions",
        "flush:sessions": "docker compose exec -T redis redis-cli FLUSHALL"
    },
    "devDependencies": {
        "@contractkit/prettier-plugin": "^0.14.9",
        "@types/node": "^26.1.2",
        "eslint": "^10.8.0",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "turbo": "^2.10.8",
        "typescript": "6.0.3",
        "vitest": "^4.1.10"
    },
    "packageManager": "pnpm@11.10.0",
    "engines": {
        "node": ">=26"
    }
}
