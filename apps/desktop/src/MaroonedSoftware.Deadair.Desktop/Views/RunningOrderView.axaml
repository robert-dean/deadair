<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:conv="using:MaroonedSoftware.Deadair.Desktop.Themes"
    xmlns:controls="using:MaroonedSoftware.Deadair.Desktop.Controls"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.RunningOrderView"
    x:DataType="vm:RunningOrderViewModel">

    <UserControl.Styles>
        <!-- Skip-to shares the length's column and takes its place on hover, for a row that can be
             skipped to. The panel is 320 wide and a fourth button column would leave a title about
             sixty units; the length is the thing on the row least needed while reaching for it. -->
        <Style Selector="ListBoxItem:pointerover TextBlock.length.skippable">
            <Setter Property="Opacity" Value="0" />
        </Style>
    </UserControl.Styles>

    <DockPanel IsVisible="{Binding IsOperator}" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
<TextBlock Classes="h3" Text="{Binding Name}" />

            <!-- What the operator asked for, in their own words. It keeps steering every refill, so
                 it is shown rather than only accepted. -->
            <TextBlock Text="{Binding Brief}" Classes="secondary" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding Brief, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource DaTextSecondaryBrush}" />
            <TextBlock Text="{Binding Host, StringFormat='Hosted by {0}'}" FontSize="12"
                       IsVisible="{Binding Host, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource DaTextDimmedBrush}" />

            <!-- No Shuffle or Extend now here: Shuffle is beside the play button in the bar, where it
                 is a click away from every page, and the station extends a short order on its own. -->

            <!-- Undo is offered only for a record. A segment is marked removed by the station and
                 cannot come back, so offering it would be offering something that cannot happen. -->
            <Button Classes="ghost" Content="{Binding UndoLabel}" Command="{Binding UndoDropCommand}"
                    IsVisible="{Binding CanUndo}" HorizontalAlignment="Left" />

            <TextBlock Text="{Binding RunsDryLabel}" FontSize="12"
                       Foreground="{Binding IsShort, Converter={x:Static conv:ShortOrderBrushConverter.Instance}}" />
        </StackPanel>

        <!-- A virtualising list rather than a grid: Avalonia 12 deprecates DataGrid, and an order can
             run to hundreds of rows. -->
        <ListBox Classes="rows" ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:OrderItemViewModel">
                    <!-- Fixed widths on the last two columns. Every row is its own Grid, so an
                         `Auto` column sizes to that row alone: a row whose move buttons are hidden
                         gave its duration a different x from the row above, and the times marched
                         about down the list. -->
                    <!-- The cover where the state dot was, as History draws its rows. A segment has no
                         cover and shows its initial; its state is still said in words under its title. -->
                    <Grid ColumnDefinitions="36,*,44,92" ColumnSpacing="10">
                        <controls:Artwork Size="36" VerticalAlignment="Center"
                                          Source="{Binding ArtworkUrl}"
                                          Initial="{Binding Initial}" />

                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DaTextBrush}" />
                            <TextBlock Text="{Binding Artists}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding !IsSegment}"
                                       Foreground="{DynamicResource DaTextDimmedBrush}" />
                            <TextBlock Text="{Binding Label}" FontSize="11"
                                       IsVisible="{Binding IsSegment}"
                                       Foreground="{DynamicResource DaTextDimmedBrush}" />
                        </StackPanel>

                        <Panel Grid.Column="2">
                            <TextBlock Classes="mono length" Classes.skippable="{Binding CanSkipTo}"
                                       Text="{Binding Length}" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource DaTextDimmedBrush}" />
                            <!-- Reaches past what the player holds and cuts what is on air, so it is
                                 the one control here every listener hears at once; it asks first. -->
                            <Button Classes="icon small reveal" HorizontalAlignment="Right"
                                    IsVisible="{Binding CanSkipTo}"
                                    ToolTip.Tip="Skip straight to this record. Everything in front of it is passed over and what is on air is cut."
                                    Command="{Binding $parent[ListBox].((vm:RunningOrderViewModel)DataContext).SkipToCommand}"
                                    CommandParameter="{Binding}">
                                <PathIcon Width="13" Height="13" Data="{DynamicResource DaIconSkip}" />
                            </Button>
                        </Panel>

                        <!-- Opacity rather than visibility, and a column that is always 92 wide:
                             every row is its own Grid, so a column that collapsed when its buttons
                             were hidden would move the duration on that row alone. -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                    HorizontalAlignment="Right" Opacity="{Binding CanMove, Converter={x:Static conv:MovableOpacityConverter.Instance}}"
                                    IsHitTestVisible="{Binding CanMove}">
                            <Button Classes="icon small"
                                    Command="{Binding $parent[ListBox].((vm:RunningOrderViewModel)DataContext).MoveUpCommand}"
                                    CommandParameter="{Binding}">
                                <PathIcon Width="13" Height="13" Data="{DynamicResource DaIconChevronUp}" />
                            </Button>
                            <Button Classes="icon small"
                                    Command="{Binding $parent[ListBox].((vm:RunningOrderViewModel)DataContext).MoveDownCommand}"
                                    CommandParameter="{Binding}">
                                <PathIcon Width="13" Height="13" Data="{DynamicResource DaIconChevronDown}" />
                            </Button>
                            <Button Classes="icon small"
                                    Command="{Binding $parent[ListBox].((vm:RunningOrderViewModel)DataContext).DropCommand}"
                                    CommandParameter="{Binding}">
                                <PathIcon Width="13" Height="13" Data="{DynamicResource DaIconClose}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>

</UserControl>
