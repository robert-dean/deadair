<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:views="using:MaroonedSoftware.Deadair.Desktop.Views"
    xmlns:conv="using:MaroonedSoftware.Deadair.Desktop.Themes"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.Sidebar"
    x:DataType="vm:ShellViewModel">

    <!-- Bound to the SHELL rather than to the navigation, so the account entry below can reach the
         session without a `$parent[Window]` hop. Setting DataContext on a child re-scopes every
         binding on it, so a control that needs two view models is better given the one that owns
         both. -->
    <DockPanel Background="{DynamicResource DaPanelBrush}">
        <Border DockPanel.Dock="Right" Width="1" Background="{DynamicResource DaBorderBrush}" />

        <!-- The window's client area runs under the title bar, so this strip is where the traffic
             lights sit and is the region the window is dragged by. 80px of padding is the room they
             need; `WindowDecorationMargin` could say so exactly, but it reads as zero in a headless
             render and the layout must not differ between what is drawn and what is looked at. -->
        <Border DockPanel.Dock="Top" Height="38" Padding="80,0,12,0"
                chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- The mark and the wordmark together, as the console's header has them. The MARK
                     rather than the lockup: at 20px the arched "deadair radio" is illegible, and the
                     wordmark beside it is already saying the name. Decorative, so it is not in the
                     tab order and announces nothing. -->
                <Image Source="avares://deadair/Assets/logo-mark.png" Width="20" Height="20" />
                <TextBlock Text="deadair" FontSize="15" FontWeight="Bold" LetterSpacing="1.4"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DaAccentBrush}" />
            </StackPanel>
        </Border>

        <!--
            The account.

            It used to be a panel inside the desk, which put signing in on one particular page and
            made the desk two things at once. It belongs here for the same reason the section
            headings do: an account is about the whole app rather than about what is on air, and the
            sidebar is already where the app says what this account can reach.
        -->
        <Border DockPanel.Dock="Bottom" Padding="12,10" MinHeight="56"
                BorderBrush="{DynamicResource DaBorderBrush}" BorderThickness="0,1,0,0">
            <Panel>
                <!-- Signed out. The flyout keeps sign-in out of the page stack: it is a thing you do
                     and leave, not a place you go, and it must not take somebody off whatever they
                     were reading. -->
                <Button x:Name="SignIn" Classes="nav" IsVisible="{Binding SignedOut}"
                        Height="36" Padding="8,0">
                    <Grid ColumnDefinitions="16,*,14" ColumnSpacing="10">
                        <PathIcon Data="{DynamicResource DaIconPerson}" />
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="Sign in" FontSize="13"
                                       Foreground="{DynamicResource DaTextBrush}" />
                            <TextBlock Classes="eyebrow" Text="OPERATOR DESK" />
                        </StackPanel>
                        <PathIcon Grid.Column="2" Width="12" Height="12"
                                  Data="{DynamicResource DaIconChevronRight}"
                                  Foreground="{DynamicResource DaTextDimmedBrush}" />
                    </Grid>

                    <Button.Flyout>
                        <Flyout Placement="RightEdgeAlignedBottom" ShowMode="Standard">
                            <views:LoginView Width="320"
                                             DataContext="{Binding $parent[views:Sidebar].((vm:ShellViewModel)DataContext).Login}" />
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Signed in. Signing out leaves somebody listening, so it is a quiet icon rather
                     than a button competing with the rail. -->
                <Grid ColumnDefinitions="16,*,32" ColumnSpacing="10" IsVisible="{Binding !SignedOut}"
                      Margin="8,0">
                    <PathIcon Data="{DynamicResource DaIconPerson}"
                              Foreground="{DynamicResource DaTextSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Account}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource DaTextBrush}" />
                        <TextBlock Classes="eyebrow" Text="OPERATOR"
                                   Foreground="{DynamicResource DaAccentBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Sign out"
                            Command="{Binding SignOutCommand}">
                        <PathIcon Data="{DynamicResource DaIconSignOut}" />
                    </Button>
                </Grid>
            </Panel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Navigation.Sections}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavigationSectionViewModel">
                        <StackPanel IsVisible="{Binding IsVisible}" Margin="0,10,0,0">
                            <TextBlock Classes="eyebrow" Text="{Binding Label}" Margin="20,0,0,6" />

                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                        <Button Classes="nav" Classes.active="{Binding IsCurrent}"
                                                IsVisible="{Binding IsVisible}"
                                                Margin="8,0,8,2"
                                                Command="{Binding $parent[views:Sidebar].((vm:ShellViewModel)DataContext).Navigation.GoToCommand}"
                                                CommandParameter="{Binding}">
                                            <!-- Fixed columns rather than Auto: every row is its own
                                                 Grid, so an Auto column sizes to that row alone and
                                                 the labels would start at different x positions
                                                 depending on whether the accent bar is drawn. -->
                                            <Grid ColumnDefinitions="3,16,*,14" ColumnSpacing="10">
                                                <Rectangle Width="3" Height="16" RadiusX="2" RadiusY="2"
                                                           Fill="{DynamicResource DaAccentBrush}"
                                                           IsVisible="{Binding IsCurrent}" />
                                                <PathIcon Grid.Column="1"
                                                          Data="{Binding Icon, Converter={x:Static conv:IconConverter.Instance}}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Label}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Key}"
                                                           FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource DaTextDimmedBrush}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

</UserControl>
