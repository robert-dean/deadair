<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.RecastDialogView"
    x:DataType="vm:RecastDialogViewModel">

    <StackPanel Spacing="12" Width="420">
        <TextBlock TextWrapping="Wrap" Classes="secondary"
                   Text="Changing it rewrites the breaks already written for this show, and one that is not ready when its slot comes round is skipped." />

        <!-- Bounded and scrolling, because the list is as long as the operator has made it. Hosts
             only: a caller phones in and is never put on air. -->
        <ListBox Classes="rows" ItemsSource="{Binding Choices}" SelectedItem="{Binding Chosen}"
                 MaxHeight="300">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:HostChoice">
                    <!-- The tick says which is chosen: these rows are otherwise the app's read-only
                         lists, which draw no selection on purpose. -->
                    <Grid ColumnDefinitions="16,*,120" ColumnSpacing="10" Margin="0,4">
                        <PathIcon Width="14" Height="14" Data="{DynamicResource DaIconCheck}"
                                  Foreground="{DynamicResource DaAccentBrush}"
                                  IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource DaTextBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11"
                                   VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource DaTextDimmedBrush}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>

</UserControl>
