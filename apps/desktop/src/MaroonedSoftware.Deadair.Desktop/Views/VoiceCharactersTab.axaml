<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:views="using:MaroonedSoftware.Deadair.Desktop.Views"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.VoiceCharactersTab"
    x:DataType="vm:CharactersViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
            <!-- New host is the one primary: it is what this tab is for. Restore is a plain button
                 because pressing it twice is harmless; it writes only what is missing. -->
            <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Button Classes="primary" Content="New host" Command="{Binding NewHostCommand}" />
                <Button Classes="ghost" Content="New caller" Command="{Binding NewCallerCommand}" />
                <Button Classes="ghost" Content="Import" Command="{Binding ImportCommand}" />
                <Button Classes="ghost" Content="Export all" Command="{Binding ExportAllCommand}" />
                <Button Classes="ghost" Content="Restore built-ins" Command="{Binding RestoreCommand}" />
            </WrapPanel>

            <!-- The two station settings that are about every character: what an unnamed host is
                 called, and how long a story in parts rests. What stays on screen is who they
                 reach, which is also the way in to changing them. -->
            <Border Classes="card" Padding="12" MaxWidth="680" HorizontalAlignment="Left"
                    IsVisible="{Binding SettingsForm, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="eyebrow" Text="Presenter name" />
                                <TextBlock Classes="dimmed" FontSize="12" TextWrapping="Wrap" Text="{Binding PresenterNameSummary}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Classes="eyebrow" Text="Returning to a story" />
                                <TextBlock Classes="dimmed" FontSize="12" TextWrapping="Wrap" Text="{Binding StoryWaitSummary}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghost" FontSize="12" Padding="10,3" VerticalAlignment="Top"
                                Content="{Binding SettingsToggleLabel}" Command="{Binding ToggleSettingsCommand}" />
                    </Grid>
                    <StackPanel Spacing="4" IsVisible="{Binding EditingSettings}">
                        <ItemsControl ItemsSource="{Binding SettingsForm.Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FormFieldViewModel">
                                    <views:FormFieldView />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="primary" Content="Save" HorizontalAlignment="Right" Command="{Binding SaveSettingsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBox Text="{Binding Filter}" PlaceholderText="Find a character" MaxWidth="360"
                     HorizontalAlignment="Left" MinWidth="240" IsVisible="{Binding ShowsFilter}" />

            <TextBlock Classes="dimmed" Text="{Binding Notice}" TextWrapping="Wrap"
                       IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="dimmed" Text="{Binding Empty}" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                       IsVisible="{Binding Empty, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <ListBox Classes="rows" ItemsSource="{Binding Rows}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PersonaRowViewModel">
                    <StackPanel Spacing="4" Margin="0,4">
                        <!-- A heading at each changeover rather than two lists. -->
                        <TextBlock Classes="eyebrow" Text="{Binding Heading}" Margin="22,4,0,6" IsVisible="{Binding HasHeading}" />

                        <Grid ColumnDefinitions="14,*,236" ColumnSpacing="8">
                            <!-- The tally: one persona presents at a time. The column keeps its width
                                 whether the lamp is drawn or not, or the names do not line up. -->
                            <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,6,0,0"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource DaToneLiveBrush}" IsVisible="{Binding Presenting}" />

                            <StackPanel Grid.Column="1" Spacing="3">
                                <WrapPanel ItemSpacing="8">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource DaTextBrush}" />
                                    <TextBlock Text="On air now" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DaToneLiveBrush}" IsVisible="{Binding Presenting}" />
                                    <TextBlock Text="Station's own" FontSize="11" VerticalAlignment="Center" Classes="dimmed"
                                               IsVisible="{Binding ShowsStationsOwn}" />
                                    <TextBlock Text="{Binding DjName}" FontSize="11" VerticalAlignment="Center" Classes="secondary"
                                               IsVisible="{Binding DjName, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </WrapPanel>

                                <!-- Clamped: an unconstrained style sentence sets the row's height. -->
                                <TextBlock Text="{Binding Style}" FontSize="12" TextWrapping="Wrap" MaxLines="3"
                                           TextTrimming="CharacterEllipsis" MaxWidth="680" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource DaTextSecondaryBrush}" />
                                <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" Classes="dimmed"
                                           MaxWidth="680" HorizontalAlignment="Left"
                                           IsVisible="{Binding Summary, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{Binding RingsIn}" FontSize="11" TextWrapping="Wrap" Classes="dimmed"
                                           IsVisible="{Binding RingsIn, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasVoice}">
                                    <TextBlock Text="{Binding VoiceLine}" FontSize="11" Classes="dimmed"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                    <!-- A voice is judged by ear, heard over the station rather than instead of it. -->
                                    <Button Classes="ghost" FontSize="11" Padding="8,1" Content="{Binding PlayLabel}"
                                            Command="{Binding $parent[ListBox].((vm:CharactersViewModel)DataContext).PlayVoiceCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>

                                <!-- How it is doing on air, and the way to read what it said: keyed on the
                                     character's key, which the history stamps, so it outlives the sheet. -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Record}" FontSize="11" Classes="mono" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DaTextDimmedBrush}"
                                               IsVisible="{Binding Record, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <Button Classes="ghost" FontSize="11" Padding="8,1" Content="What they've said"
                                            Command="{Binding $parent[ListBox].((vm:CharactersViewModel)DataContext).ShowSaidCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>

                                <!-- The one action anybody comes to this tab for, so it is always drawn. -->
                                <Button Classes="ghost" FontSize="11" Padding="8,3" Content="Make station host" Margin="0,4,0,0"
                                        IsVisible="{Binding CanMakeHost}"
                                        Command="{Binding $parent[ListBox].((vm:CharactersViewModel)DataContext).MakeStationHostCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>

                            <!-- The rest arrive with the pointer, in a column of their own so every
                                 card's text is the same width. Delete is last. -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right"
                                        VerticalAlignment="Top">
                                <Button Classes="reveal ghost" FontSize="11" Padding="8,3" Content="Rehearse"
                                        Command="{Binding $parent[ListBox].((vm:CharactersViewModel)DataContext).RehearseCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Classes="reveal ghost" FontSize="11" Padding="8,3" Content="Edit"
                                        Command="{Binding $parent[ListBox].((vm:CharactersViewModel)DataContext).EditCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Classes="reveal ghost" FontSize="11" Padding="8,3" Content="Export"
                                        Command="{Binding $parent[ListBox].((vm:CharactersViewModel)DataContext).ExportCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Classes="reveal ghost" FontSize="11" Padding="8,3" Content="Delete"
                                        Command="{Binding $parent[ListBox].((vm:CharactersViewModel)DataContext).DeleteCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>

</UserControl>
