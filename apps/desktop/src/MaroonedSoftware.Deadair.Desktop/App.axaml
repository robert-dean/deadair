<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="MaroonedSoftware.Deadair.Desktop.App"
    RequestedThemeVariant="Default">

    <Application.Styles>
        <!-- Compact, because a desk is dense: the app's density argument lives in spacing and row
             height rather than in a smaller type scale. -->
        <FluentTheme DensityStyle="Compact" />
        <!-- After Fluent, so a class here wins over the control theme it is narrowing. -->
        <StyleInclude Source="avares://deadair/Themes/Styles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://deadair/Themes/Tokens.axaml" />
                <ResourceInclude Source="avares://deadair/Themes/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
