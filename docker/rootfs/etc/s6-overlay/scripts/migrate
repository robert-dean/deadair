#!/bin/sh -e
# The schema, before anything reads it.
#
# The station does not migrate itself at boot and should not: an out-of-date schema degrades
# QUIETLY here (the settings layer answers empty rather than failing), which is the worst way for
# this to go wrong. So it happens once, out here, loudly, before the API is allowed to start.

# shellcheck source=/dev/null
. /etc/s6-overlay/scripts/database-env

if [ -z "${DATABASE_HOST:-}" ] || [ -z "${DATABASE_USER:-}" ] || [ -z "${DATABASE_NAME:-}" ]; then
    cat >&2 <<'MESSAGE'
deadair: no database.

This image needs DATABASE_HOST, DATABASE_PORT, DATABASE_USER, DATABASE_PASSWORD and
DATABASE_NAME, and REDIS_HOST and REDIS_PORT beside them. The `full` tag of this image
brings its own instead, if you would rather not run them yourself.
MESSAGE
    exit 1
fi

case "${MIGRATE_ON_BOOT:-true}" in
    false | 0 | no | off)
        echo "migrate: MIGRATE_ON_BOOT is off; the schema is yours to apply" >&2
        exit 0
        ;;
esac

# Composed here rather than asked for as a URL, because everything else about this station's
# database is five separate variables and a sixth spelling of the same facts is a way for them to
# disagree. The password is percent-encoded: a password is allowed to contain the characters that
# end a URL's authority, and one that does would otherwise produce a connection string that parses
# cleanly into the wrong host.
encoded_password=$(
    DATABASE_PASSWORD="${DATABASE_PASSWORD:-}" node -e \
        'process.stdout.write(encodeURIComponent(process.env.DATABASE_PASSWORD ?? ""))'
)

# The search path is part of the URL because dbmate asks the database where its own bookkeeping
# table lives when the URL does not say, and asks again for every statement that touches it. The
# answer is `select current_schema()`, and PostgreSQL's default path is `"$user", public`, so for a
# role named `deadair` (the obvious name beside this station's own DATABASE_NAME default) the
# answer changes the moment the first migration creates the `deadair` schema. The table was made in
# `public`; the insert recording that migration looks for it in `deadair`, fails, and rolls the
# migration back. Every boot then applies the first migration and gets no further. `init-database`
# fixes that for the cluster this image brings by setting the role's path; the URL fixes it for
# every database, including one the operator brought and set up any way they liked.
#
# It moves no install that already works. dbmate takes the first schema on this path as the table's
# home, and a database that got past the first migration keeps it in `public`: a role named after no
# schema resolves there, and so does the bundled one. The migrations themselves run under this path
# too, which is the one they already get on the bundled database, in development and in CI, and each
# of them names `deadair.` rather than relying on it.
#
# The exception is a database that already had a schema named after its role when the station first
# migrated it, which is PostgreSQL's own advice for keeping a role out of `public`: the table was
# made in that schema. That install says so with DBMATE_MIGRATIONS_TABLE=<schema>.schema_migrations
# in the container's environment, which dbmate reads itself and ranks above the URL.
export DATABASE_URL="postgres://${DATABASE_USER}:${encoded_password}@${DATABASE_HOST}:${DATABASE_PORT:-5432}/${DATABASE_NAME}?sslmode=${DATABASE_SSLMODE:-disable}&search_path=public"

cd /app/apps/api

# The database may still be starting, in the same container or elsewhere on the network. Wait
# rather than fail: a station that gives up because its database was four seconds behind it is a
# station that needs an operator to restart it for no reason.
attempt=1
until dbmate -d ./data/migrations --no-dump-schema up; do
    if [ "$attempt" -ge 30 ]; then
        echo "migrate: the database did not answer after $attempt attempts; giving up" >&2
        exit 1
    fi
    echo "migrate: no answer yet (attempt $attempt); waiting" >&2
    attempt=$((attempt + 1))
    sleep 2
done
