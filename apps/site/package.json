{
    "name": "@deadair/site",
    "private": true,
    "license": "MIT",
    "scripts": {
        "start": "node scripts/docs.sync.mjs && docusaurus start",
        "build": "tsc --noEmit && node scripts/docs.sync.mjs && docusaurus build --out-dir dist",
        "serve": "docusaurus serve --dir dist",
        "clear": "docusaurus clear",
        "lint": "eslint --fix",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write . --ignore-path ../../.prettierignore"
    },
    "devDependencies": {
        "@docusaurus/core": "^3.10.2",
        "@docusaurus/faster": "^3.10.2",
        "@docusaurus/module-type-aliases": "^3.10.2",
        "@docusaurus/preset-classic": "^3.10.2",
        "@docusaurus/theme-classic": "^3.10.2",
        "@docusaurus/types": "^3.10.2",
        "@fontsource/chakra-petch": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/ibm-plex-sans": "^5.3.0",
        "@mdx-js/react": "^3.1.0",
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "@types/react": "^19.2.18",
        "prettier": "^3.9.6",
        "prism-react-renderer": "^2.4.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "typescript": "6.0.3"
    },
    "browserslist": {
        "production": [
            ">0.5%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 3 chrome version",
            "last 3 firefox version",
            "last 5 safari version"
        ]
    }
}
