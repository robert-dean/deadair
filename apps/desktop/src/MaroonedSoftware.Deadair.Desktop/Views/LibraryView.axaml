<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.LibraryView"
    x:DataType="vm:LibraryViewModel">

    <DockPanel Margin="24" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,14">
            <TextBlock Text="Library" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource DaTextBrush}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding Search}" PlaceholderText="Search records"
                         IsEnabled="{Binding !Busy}" />
                <Button Grid.Column="1" Content="Search" Command="{Binding SearchTracksCommand}" />
            </Grid>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,12,0,0">
            <Button Content="Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoBack}" />
            <TextBlock Grid.Column="1" Text="{Binding Summary}" VerticalAlignment="Center"
                       HorizontalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource DaTextDimmedBrush}" />
            <Button Grid.Column="2" Content="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoForward}" />
        </Grid>

        <ListBox ItemsSource="{Binding Tracks}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackRowViewModel">
                    <Grid ColumnDefinitions="*,180,60,50" ColumnSpacing="12" Margin="0,3">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource DaTextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Artists}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource DaTextSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding Year}" FontFamily="monospace" FontSize="11"
                                   Foreground="{DynamicResource DaTextDimmedBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding Length}" FontFamily="monospace" FontSize="11"
                                   Foreground="{DynamicResource DaTextDimmedBrush}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>

</UserControl>
