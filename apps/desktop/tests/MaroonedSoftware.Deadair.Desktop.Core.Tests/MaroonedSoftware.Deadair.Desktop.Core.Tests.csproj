<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>MaroonedSoftware.Deadair.Desktop.Core.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/MaroonedSoftware.Deadair.Desktop.Core/MaroonedSoftware.Deadair.Desktop.Core.csproj" />
        <!--
            The navigation table is a rule about the station's account model rather than about
            Avalonia — which pages a listener can reach without signing in — so it is worth a test
            even though the table lives in the app project.
        -->
        <ProjectReference Include="../../src/MaroonedSoftware.Deadair.Desktop/MaroonedSoftware.Deadair.Desktop.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The fixture plugin, bundled through the same targets the app uses so that the copy itself
            is under test: it lands in plugins/deadair.fixture/ beside these tests, complete with its
            deps.json, and the loader is pointed at it there. Deliberately NOT a ProjectReference:
            nothing here may compile against a plugin, or the test would prove the loader works on an
            assembly the runtime had already loaded for it.
        -->
        <BundledPlugin Include="../MaroonedSoftware.Deadair.Desktop.PluginSdk.Fixture/MaroonedSoftware.Deadair.Desktop.PluginSdk.Fixture.csproj" PluginId="deadair.fixture" />

        <!--
            And the real plugin the app ships, bundled here the same way. A fixture proves the loader
            works on something written to be loaded; this proves it works on the one that was written
            to play music, through its own manifest and its own entry type, with no reference to it
            from anything here.
        -->
        <BundledPlugin Include="../../plugins/bluos/src/MaroonedSoftware.Deadair.Desktop.Plugins.BluOs/MaroonedSoftware.Deadair.Desktop.Plugins.BluOs.csproj" PluginId="deadair.bluos" />
    </ItemGroup>

</Project>
