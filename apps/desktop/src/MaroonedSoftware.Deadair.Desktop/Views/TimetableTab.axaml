<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    xmlns:views="using:MaroonedSoftware.Deadair.Desktop.Views"
    xmlns:conv="using:MaroonedSoftware.Deadair.Desktop.Themes"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.TimetableTab"
    x:DataType="vm:TimetableViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
        <StackPanel Spacing="14">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Classes="dimmed" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                           Text="A repeating week: every block runs on the days it is set to, and the hours nothing covers play the sustaining source. A change takes effect when the block next comes round." />
                <Button Grid.Column="1" Classes="ghost" Content="Add slot" VerticalAlignment="Top"
                        Command="{Binding AddSlotCommand}" />
            </Grid>

            <TextBlock Classes="dimmed" Text="{Binding Problem}" TextWrapping="Wrap"
                       IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <!-- A timetable rather than a table: the rule down the middle is what makes a list of
                 times read as a day, and the dot on it is where the station actually is. Edited
                 through a dialog and never by dragging: a wrong drop reschedules a broadcast. -->
            <ListBox Classes="rows" ItemsSource="{Binding Slots}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SlotViewModel">
                        <Grid ColumnDefinitions="110,20,*,116" ColumnSpacing="12">
                            <TextBlock Classes="mono" Grid.Column="0" Text="{Binding Window}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DaTextSecondaryBrush}" />

                            <Panel Grid.Column="1">
                                <!-- Negative by exactly the row's own vertical padding, so the rule
                                     joins up between rows instead of drawing as a column of dashes. -->
                                <Rectangle Width="2" HorizontalAlignment="Center" Margin="0,-6"
                                           Fill="{DynamicResource DaBorderBrush}" />
                                <Ellipse Classes="lamp" Classes.live="{Binding IsAiring}" Width="7" Height="7"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="{Binding IsAiring, Converter={x:Static conv:AiringBrushConverter.Instance}}" />
                            </Panel>

                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource DaTextBrush}" />
                                <!-- The pill on the days' line rather than beside the name: beside a
                                     name long enough to trim, it was pushed off the row. It marks the
                                     slot actually airing, which is not always the one the clock says. -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Days}" Classes="dimmed" FontSize="11" VerticalAlignment="Center" />
                                    <Border Classes="pill" IsVisible="{Binding IsAiring}" Height="18"
                                            Padding="7,0" BorderThickness="0"
                                            Background="{DynamicResource DaToneLiveBrush}">
                                        <!-- White in both appearances, as a studio's tally is: the
                                             window's own background was black on the dark red and
                                             could not be read. -->
                                        <TextBlock Classes="eyebrow" Text="ON AIR" FontSize="10"
                                                   Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Brief}" Classes="dimmed" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding Brief, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Classes="ghost reveal" Content="Edit" Padding="8,3"
                                        Command="{Binding $parent[ListBox].((vm:TimetableViewModel)DataContext).EditSlotCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Classes="ghost reveal" Content="Delete" Padding="8,3"
                                        Command="{Binding $parent[ListBox].((vm:TimetableViewModel)DataContext).DeleteSlotCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- A fact about every boundary drawn above, so it sits under the list, as the web
                 console's sits under its grid. -->
            <Border Classes="card" IsVisible="{Binding Overrun.HasForm}">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="eyebrow" Text="AT A BOUNDARY" />
                        <TextBlock Classes="dimmed" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                                   Text="Only the schedule's own changeovers are affected. A programme you put on by hand always lets the record finish." />
                    </StackPanel>
                    <views:SettingsSubsetView DataContext="{Binding Overrun}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
