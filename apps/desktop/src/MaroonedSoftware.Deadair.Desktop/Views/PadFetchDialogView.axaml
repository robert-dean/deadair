<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Deadair.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Deadair.Desktop.Views.PadFetchDialogView"
    x:DataType="vm:PadFetchDialogViewModel">

    <StackPanel Spacing="10" Width="440">
        <StackPanel Spacing="3">
            <TextBlock Text="Address" FontSize="12" Classes="secondary" />
            <TextBox Text="{Binding Address}" PlaceholderText="https://example.com/airhorn.wav" />
            <TextBlock Text="Followed once, up to 25 MB, and refused unless what comes back is a format the station serves."
                       FontSize="11" Classes="dimmed" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="3">
            <TextBlock Text="Board" FontSize="12" Classes="secondary" />
            <AutoCompleteBox Text="{Binding Board}" ItemsSource="{Binding Boards}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" />
        </StackPanel>
    </StackPanel>

</UserControl>
